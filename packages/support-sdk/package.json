{
  "name": "@ashniva/support-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable support widget SDK for products that raise tickets into Ashniva Desk",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/browser/ashniva-support.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/esm/react.js",
      "require": "./dist/cjs/react.cjs"
    },
    "./browser": "./dist/browser/ashniva-support.iife.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.browser.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "clean": "rimraf dist node_modules"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ashniva/config": "workspace:*",
    "@ashniva/types": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "jest": "^30.5.1",
    "react": "^19.2.8",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
