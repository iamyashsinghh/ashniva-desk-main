{
  "name": "@ashniva/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared enums, workflow definitions, permission keys and API contracts for Ashniva Desk (single source of truth)",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ashniva/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.5.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
