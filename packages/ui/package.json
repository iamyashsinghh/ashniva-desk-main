{
  "name": "@ashniva/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens, global styles and reusable React components for Ashniva Desk",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/global.css": "./src/styles/global.css",
    "./tokens/tokens.css": "./src/tokens/tokens.css",
    "./tokens": "./src/tokens/tokens.ts",
    "./status-tone": "./src/tokens/status-tone.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gallery": "vite --config vite.gallery.config.ts",
    "test": "vitest run",
    "clean": "rimraf node_modules coverage"
  },
  "dependencies": {
    "@ashniva/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ashniva/config": "workspace:*",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
