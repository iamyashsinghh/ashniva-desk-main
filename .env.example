# Docker Compose development environment.
# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT ONLY.

# The Compose project name is pinned to "ashniva-desk" in docker-compose.yml, so the database,
# Redis and MinIO volumes are the same whatever the folder is called. Uncomment to point this
# checkout at a differently named set of volumes.
# COMPOSE_PROJECT_NAME=ashniva-desk

POSTGRES_USER=ashniva
POSTGRES_PASSWORD=ashniva_dev_password
POSTGRES_DB=ashniva_desk
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=ashniva
MINIO_ROOT_PASSWORD=ashniva_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=ashniva-desk-dev

# Ports published when running the app containers (docker compose --profile app up)
API_PORT=3000
WEB_PORT=5173

# Password given to every seeded demo user by the app containers (development only)
SEED_USER_PASSWORD=ChangeMe123!

# Encrypts stored integration credentials (SMTP passwords, WhatsApp and AI tokens, Git
# credentials) with AES-256-GCM. Leave it unset and the app containers fall back to a fixed
# local-preview key that is published in docker-compose.yml — fine for a demo, never for anything
# real. To use your own, generate one and paste it in:
#
#   openssl rand -base64 32
#
# Keep it. Changing it does not re-encrypt what is already stored: credentials saved under the
# previous key stop being readable and have to be entered again. It is not needed to sign in, and
# nothing outside the integration screens depends on it.
# APP_ENCRYPTION_KEY=
