/// A user's role inside one organization. A user can belong to several organizations
/// (e.g. a group employee who is also a client admin of a subsidiary).
model OrganizationMembership {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  roleId                 String    @map("role_id") @db.Uuid
  /// Job title shown in the UI (e.g. "Team Lead", "Operations Head").
  title                  String?
  /// Admin → Users → "Show Development section" toggle for seniors who stop coding.
  showDevelopmentSection Boolean   @default(true) @map("show_development_section")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------------------------
// Roles and permissions
// ---------------------------------------------------------------------------------------------

/// System roles have organizationId = NULL and isSystem = true. Organizations may add their own.
/// Uniqueness of (organization_id, key) with a nullable organization_id is enforced by partial
/// unique indexes in the migration, not by Prisma (see docs/database-plan.md).
enum RoleAudience {
  INTERNAL
  CLIENT
}

/// Row-level security since `migrations/20260929090000_roles_row_level_security`. The policy is
/// not the plain org-scoped one: it also admits the NULL-organization system roles (shared by
/// every tenant) and a role the signed-in person holds in another organization they belong to
/// (organization switching resolves that membership under the tenant it is leaving).
model Role {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean      @default(false) @map("is_system")
  /// System role a custom role was cloned from (safe starting template).
  templateKey    String?      @map("template_key")
  /// CLIENT roles may only hold client-safe permissions (packages/types CLIENT_SAFE_PERMISSIONS).
  audience       RoleAudience @default(INTERNAL)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  organization Organization?            @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  OrganizationMembership[]
  invitations  UserInvitation[]

  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// resource:action, e.g. task:approve. The list lives in packages/types.
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------------------------

/// Opaque refresh tokens, stored hashed. Rotation: each use revokes the row and creates a
/// replacement in the same family; reuse of a revoked token revokes the whole family.
/// Deliberately exempt from row-level security. `organizationId` records which organization a
/// session was opened *for*, not who owns the row. Every read that matters happens on a `@Public()`
/// route before a tenant exists, and a policy would break `POST /auth/switch-organization` and
/// silently shrink `revokeAllForUser` to the acting tenant. Evidence:
/// `migrations/20260929090000_roles_row_level_security` and `test/row-level-security.e2e-spec.ts`.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// The organization the session was opened for (multi-organization users pick one at login).
  organizationId    String?   @map("organization_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------------------------
// Audit log (append-only)
// ---------------------------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// e.g. task.status_changed, credential.revealed, release.published
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  /// GET /audit-logs orders by this and filters the organization only when asked to.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "audit_logs_created_at_id_idx")
  @@map("audit_logs")
}

