// ---------------------------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------------------------

/// organizationId is the service provider; clientOrganizationId the customer. Money columns are
/// only serialized for callers with cost:read (internalCost) / contract:read (contractValue).
model Contract {
  id                       String           @id @default(uuid(7)) @db.Uuid
  organizationId           String           @map("organization_id") @db.Uuid
  clientOrganizationId     String           @map("client_organization_id") @db.Uuid
  projectId                String?          @map("project_id") @db.Uuid
  /// Sequential per organization; shown as "CT-<year>-<number>".
  number                   Int
  numberLabel              String           @map("number_label")
  type                     ContractType
  title                    String
  description              String?
  scope                    String?
  status                   ContractStatus   @default(DRAFT)
  startDate                DateTime         @map("start_date") @db.Date
  endDate                  DateTime?        @map("end_date") @db.Date
  renewalDate              DateTime?        @map("renewal_date") @db.Date
  renewalNoticeDays        Int              @default(30) @map("renewal_notice_days")
  autoRenew                Boolean          @default(false) @map("auto_renew")
  currency                 String           @default("INR")
  contractValue            Decimal?         @map("contract_value") @db.Decimal(14, 2)
  /// Internal cost estimate; cost:read only. Never leaves the provider.
  internalCost             Decimal?         @map("internal_cost") @db.Decimal(14, 2)
  /// Hours the client gets per billing period (0 = the contract does not track hours).
  includedMinutesPerPeriod Int              @default(0) @map("included_minutes_per_period")
  billingPeriod            BillingPeriod    @default(MONTHLY) @map("billing_period")
  carryForwardRule         CarryForwardRule @default(NONE) @map("carry_forward_rule")
  carryForwardCapMinutes   Int?             @map("carry_forward_cap_minutes")
  lowHoursThresholdMinutes Int              @default(300) @map("low_hours_threshold_minutes")
  internalNotes            String?          @map("internal_notes")
  /// Shown to the client on the portal.
  clientNotes              String?          @map("client_notes")
  createdById              String           @map("created_by_id") @db.Uuid
  archivedAt               DateTime?        @map("archived_at")
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  deletedAt                DateTime?        @map("deleted_at")

  organization       Organization         @relation("ContractOwner", fields: [organizationId], references: [id])
  clientOrganization Organization         @relation("ContractClient", fields: [clientOrganizationId], references: [id])
  project            Project?             @relation(fields: [projectId], references: [id])
  createdBy          User                 @relation("ContractCreator", fields: [createdById], references: [id])
  milestones         Milestone[]
  paymentMilestones  PaymentMilestone[]
  ledger             ContractHourLedger[]
  periods            ContractPeriod[]
  documents          File[]
  changeRequests     ChangeRequest[]
  approvals          ApprovalRequest[]
  invoices           Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@index([projectId])
  @@index([endDate])
  @@map("contracts")
}

/// One row per billing period of an hour-tracking contract; the ledger's periodStart points here.
model ContractPeriod {
  id          String    @id @default(uuid(7)) @db.Uuid
  contractId  String    @map("contract_id") @db.Uuid
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  /// Set when the period was closed (unused hours expired or carried forward).
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, periodStart])
  @@map("contract_periods")
}

/// Append-only hour ledger. Every movement records the balance after it, so history is
/// auditable without recomputation. Duplicate deductions are impossible by construction: a
/// partial unique index allows one CONSUMED row per work log (see the migration).
model ContractHourLedger {
  id                  String         @id @default(uuid(7)) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  contractId          String         @map("contract_id") @db.Uuid
  kind                HourLedgerKind
  /// Signed minutes: credits positive, debits negative.
  minutes             Int
  balanceAfterMinutes Int            @map("balance_after_minutes")
  periodStart         DateTime       @map("period_start") @db.Date
  periodEnd           DateTime?      @map("period_end") @db.Date
  workLogId           String?        @map("work_log_id") @db.Uuid
  taskId              String?        @map("task_id") @db.Uuid
  ticketId            String?        @map("ticket_id") @db.Uuid
  reason              String?
  /// Caller-supplied key that makes manual credits and adjustments safe to retry.
  idempotencyKey      String?        @map("idempotency_key")
  createdById         String?        @map("created_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workLog      WorkLog?     @relation(fields: [workLogId], references: [id])
  ticket       Ticket?      @relation(fields: [ticketId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([contractId, createdAt])
  @@index([organizationId, createdAt])
  @@index([workLogId])
  /// One billing period of one contract: how every balance is read.
  @@index([contractId, periodStart], map: "contract_hour_ledger_contract_period_idx")
  @@map("contract_hour_ledger")
}

model PaymentMilestone {
  id               String                 @id @default(uuid(7)) @db.Uuid
  contractId       String                 @map("contract_id") @db.Uuid
  milestoneId      String?                @map("milestone_id") @db.Uuid
  title            String
  amount           Decimal                @db.Decimal(14, 2)
  currency         String                 @default("INR")
  dueDate          DateTime?              @map("due_date") @db.Date
  status           PaymentMilestoneStatus @default(PENDING)
  invoiceReference String?                @map("invoice_reference")
  paidAt           DateTime?              @map("paid_at")
  sortOrder        Int                    @default(0) @map("sort_order")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])

  @@index([contractId, sortOrder])
  @@map("payment_milestones")
}

// ---------------------------------------------------------------------------------------------
// Milestones and deliverables
// ---------------------------------------------------------------------------------------------

model Milestone {
  id               String                @id @default(uuid(7)) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  projectId        String                @map("project_id") @db.Uuid
  contractId       String?               @map("contract_id") @db.Uuid
  changeRequestId  String?               @map("change_request_id") @db.Uuid
  name             String
  description      String?
  ownerUserId      String?               @map("owner_user_id") @db.Uuid
  startDate        DateTime?             @map("start_date") @db.Date
  dueDate          DateTime?             @map("due_date") @db.Date
  status           MilestoneStatus       @default(PLANNED)
  progressPercent  Int                   @default(0) @map("progress_percent")
  progressMode     MilestoneProgressMode @default(AUTO) @map("progress_mode")
  clientVisible    Boolean               @default(false) @map("client_visible")
  requiresApproval Boolean               @default(false) @map("requires_approval")
  sortOrder        Int                   @default(0) @map("sort_order")
  completedAt      DateTime?             @map("completed_at")
  createdById      String                @map("created_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")

  organization      Organization           @relation(fields: [organizationId], references: [id])
  project           Project                @relation(fields: [projectId], references: [id])
  contract          Contract?              @relation(fields: [contractId], references: [id])
  changeRequest     ChangeRequest?         @relation(fields: [changeRequestId], references: [id])
  owner             User?                  @relation("MilestoneOwner", fields: [ownerUserId], references: [id])
  createdBy         User                   @relation("MilestoneCreator", fields: [createdById], references: [id])
  deliverables      MilestoneDeliverable[]
  dependsOn         MilestoneDependency[]  @relation("MilestoneDependent")
  dependents        MilestoneDependency[]  @relation("MilestoneDependency")
  history           MilestoneHistory[]
  tasks             Task[]
  paymentMilestones PaymentMilestone[]
  files             File[]
  invoices          Invoice[]

  @@index([organizationId, status])
  @@index([projectId, sortOrder])
  @@index([contractId])
  @@index([ownerUserId])
  @@index([dueDate])
  @@map("milestones")
}

model MilestoneDeliverable {
  id          String    @id @default(uuid(7)) @db.Uuid
  milestoneId String    @map("milestone_id") @db.Uuid
  title       String
  description String?
  isDone      Boolean   @default(false) @map("is_done")
  doneAt      DateTime? @map("done_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, sortOrder])
  @@map("milestone_deliverables")
}

/// milestone depends on dependsOn (must finish first). Cycles are rejected by the service.
model MilestoneDependency {
  milestoneId String @map("milestone_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  milestone Milestone @relation("MilestoneDependent", fields: [milestoneId], references: [id], onDelete: Cascade)
  dependsOn Milestone @relation("MilestoneDependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([milestoneId, dependsOnId])
  @@index([dependsOnId])
  @@map("milestone_dependencies")
}

/// Append-only completion / change history of a milestone.
model MilestoneHistory {
  id          String               @id @default(uuid(7)) @db.Uuid
  milestoneId String               @map("milestone_id") @db.Uuid
  kind        MilestoneHistoryKind
  fromValue   String?              @map("from_value")
  toValue     String?              @map("to_value")
  reason      String?
  changedById String               @map("changed_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@index([milestoneId, createdAt])
  @@map("milestone_history")
}

// ---------------------------------------------------------------------------------------------
// SLA
// ---------------------------------------------------------------------------------------------

/// Which policy applies to a ticket: the project's, else the client organization's, else the
/// organization default. Targets are business minutes inside the policy's hours and timezone.
model SlaPolicy {
  id                   String         @id @default(uuid(7)) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  clientOrganizationId String?        @map("client_organization_id") @db.Uuid
  projectId            String?        @map("project_id") @db.Uuid
  name                 String
  description          String?
  isDefault            Boolean        @default(false) @map("is_default")
  timezone             String         @default("Asia/Kolkata")
  businessHoursStart   String         @default("09:00") @map("business_hours_start")
  businessHoursEnd     String         @default("18:00") @map("business_hours_end")
  /// ISO weekday numbers (1 = Monday … 7 = Sunday).
  businessDays         Int[]          @default([1, 2, 3, 4, 5]) @map("business_days")
  pauseStatuses        TicketStatus[] @default([WAITING_CLIENT]) @map("pause_statuses")
  warningPercent       Int            @default(80) @map("warning_percent")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  organization       Organization        @relation("SlaPolicyOwner", fields: [organizationId], references: [id])
  clientOrganization Organization?       @relation("SlaPolicyClient", fields: [clientOrganizationId], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  rules              SlaPolicyRule[]
  tickets            TicketSla[]
  tierPolicies       SupportTierPolicy[] @relation("SupportTierPolicySla")

  @@index([organizationId])
  @@index([clientOrganizationId])
  @@index([projectId])
  @@map("sla_policies")
}

model SlaPolicyRule {
  id                   String   @id @default(uuid(7)) @db.Uuid
  policyId             String   @map("policy_id") @db.Uuid
  priority             Priority
  firstResponseMinutes Int      @map("first_response_minutes")
  resolutionMinutes    Int      @map("resolution_minutes")

  policy SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, priority])
  @@map("sla_policy_rules")
}

/// The SLA clocks of one ticket. Recomputed by the service on every ticket change and checked
/// by the sla-monitor job; the browser never computes SLA state.
model TicketSla {
  ticketId                    String          @id @map("ticket_id") @db.Uuid
  policyId                    String          @map("policy_id") @db.Uuid
  firstResponseDueAt          DateTime?       @map("first_response_due_at")
  firstResponseWarnAt         DateTime?       @map("first_response_warn_at")
  firstResponseAt             DateTime?       @map("first_response_at")
  firstResponseStatus         SlaTargetStatus @default(ON_TRACK) @map("first_response_status")
  resolutionDueAt             DateTime?       @map("resolution_due_at")
  resolutionWarnAt            DateTime?       @map("resolution_warn_at")
  resolvedAt                  DateTime?       @map("resolved_at")
  resolutionStatus            SlaTargetStatus @default(ON_TRACK) @map("resolution_status")
  pausedAt                    DateTime?       @map("paused_at")
  pausedTotalMinutes          Int             @default(0) @map("paused_total_minutes")
  /// Business minutes that had elapsed on each clock when the ticket was last paused.
  firstResponseElapsedMinutes Int             @default(0) @map("first_response_elapsed_minutes")
  resolutionElapsedMinutes    Int             @default(0) @map("resolution_elapsed_minutes")
  clockStartedAt              DateTime        @map("clock_started_at")
  lastEvaluatedAt             DateTime?       @map("last_evaluated_at")
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")

  ticket Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  policy SlaPolicy @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@index([firstResponseDueAt])
  @@index([resolutionDueAt])
  @@map("ticket_sla")
}

/// Append-only SLA history. Warning/breach kinds are unique per ticket (partial unique index)
/// so the monitor job can never notify twice.
model SlaEvent {
  id        String       @id @default(uuid(7)) @db.Uuid
  ticketId  String       @map("ticket_id") @db.Uuid
  kind      SlaEventKind
  detail    String?
  createdAt DateTime     @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("sla_events")
}

// ---------------------------------------------------------------------------------------------
// Change requests
// ---------------------------------------------------------------------------------------------

model ChangeRequest {
  id                   String              @id @default(uuid(7)) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  clientOrganizationId String              @map("client_organization_id") @db.Uuid
  projectId            String?             @map("project_id") @db.Uuid
  contractId           String?             @map("contract_id") @db.Uuid
  /// Sequential per organization; shown as "CR-<number>".
  number               Int
  title                String
  description          String
  businessReason       String?             @map("business_reason")
  scope                String?
  impact               String?
  estimatedMinutes     Int?                @map("estimated_minutes")
  costImpact           Decimal?            @map("cost_impact") @db.Decimal(14, 2)
  currency             String              @default("INR")
  timelineImpactDays   Int?                @map("timeline_impact_days")
  status               ChangeRequestStatus @default(DRAFT)
  internalNotes        String?             @map("internal_notes")
  decisionNote         String?             @map("decision_note")
  requestedById        String              @map("requested_by_id") @db.Uuid
  createdById          String              @map("created_by_id") @db.Uuid
  submittedAt          DateTime?           @map("submitted_at")
  approvedAt           DateTime?           @map("approved_at")
  scheduledFor         DateTime?           @map("scheduled_for") @db.Date
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")

  organization       Organization           @relation("ChangeRequestOwner", fields: [organizationId], references: [id])
  clientOrganization Organization           @relation("ChangeRequestClient", fields: [clientOrganizationId], references: [id])
  project            Project?               @relation(fields: [projectId], references: [id])
  contract           Contract?              @relation(fields: [contractId], references: [id])
  requestedBy        User                   @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  createdBy          User                   @relation("ChangeRequestCreator", fields: [createdById], references: [id])
  history            ChangeRequestHistory[]
  comments           Comment[]
  files              File[]
  tasks              Task[]
  milestones         Milestone[]
  approvals          ApprovalRequest[]
  invoices           Invoice[]

  releaseItems ReleaseItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@index([projectId])
  @@index([contractId])
  @@map("change_requests")
}

model ChangeRequestHistory {
  id              String               @id @default(uuid(7)) @db.Uuid
  changeRequestId String               @map("change_request_id") @db.Uuid
  fromStatus      ChangeRequestStatus? @map("from_status")
  toStatus        ChangeRequestStatus  @map("to_status")
  note            String?
  changedById     String               @map("changed_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  changedBy     User          @relation(fields: [changedById], references: [id])

  @@index([changeRequestId, createdAt])
  @@map("change_request_history")
}

// ---------------------------------------------------------------------------------------------
// Client approvals
// ---------------------------------------------------------------------------------------------

/// A request for the client to approve something (update, milestone, document, change request,
/// file). Internal people prepare and publish; only client users of clientOrganizationId decide.
model ApprovalRequest {
  id                   String              @id @default(uuid(7)) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  clientOrganizationId String              @map("client_organization_id") @db.Uuid
  projectId            String?             @map("project_id") @db.Uuid
  contractId           String?             @map("contract_id") @db.Uuid
  changeRequestId      String?             @map("change_request_id") @db.Uuid
  subjectType          ApprovalSubjectType @map("subject_type")
  subjectId            String              @map("subject_id") @db.Uuid
  title                String
  /// Client-visible description of what is being approved.
  summary              String
  internalNotes        String?             @map("internal_notes")
  status               ApprovalStatus      @default(DRAFT)
  dueDate              DateTime?           @map("due_date") @db.Date
  requestedById        String              @map("requested_by_id") @db.Uuid
  internalReviewerId   String?             @map("internal_reviewer_id") @db.Uuid
  internalReviewedAt   DateTime?           @map("internal_reviewed_at")
  publishedById        String?             @map("published_by_id") @db.Uuid
  publishedAt          DateTime?           @map("published_at")
  decidedById          String?             @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?           @map("decided_at")
  decisionComment      String?             @map("decision_comment")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")

  organization       Organization      @relation("ApprovalOwner", fields: [organizationId], references: [id])
  clientOrganization Organization      @relation("ApprovalClient", fields: [clientOrganizationId], references: [id])
  project            Project?          @relation(fields: [projectId], references: [id])
  contract           Contract?         @relation(fields: [contractId], references: [id])
  changeRequest      ChangeRequest?    @relation(fields: [changeRequestId], references: [id])
  requestedBy        User              @relation("ApprovalRequester", fields: [requestedById], references: [id])
  internalReviewer   User?             @relation("ApprovalInternalReviewer", fields: [internalReviewerId], references: [id])
  publishedBy        User?             @relation("ApprovalPublisher", fields: [publishedById], references: [id])
  decidedBy          User?             @relation("ApprovalDecider", fields: [decidedById], references: [id])
  history            ApprovalHistory[]
  files              File[]

  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@index([subjectType, subjectId])
  @@index([projectId])
  @@map("approval_requests")
}

model ApprovalHistory {
  id         String          @id @default(uuid(7)) @db.Uuid
  approvalId String          @map("approval_id") @db.Uuid
  fromStatus ApprovalStatus? @map("from_status")
  toStatus   ApprovalStatus  @map("to_status")
  side       ApprovalSide
  comment    String?
  actorId    String          @map("actor_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")

  approval ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actor    User            @relation(fields: [actorId], references: [id])

  @@index([approvalId, createdAt])
  @@map("approval_history")
}

// ---------------------------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------------------------

/// In-app notifications. organizationId is the organization context the recipient was acting
/// in (a client user's own organization). dedupeKey collapses repeats of the same event.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  title          String
  body           String?
  link           String?
  entityType     String?          @map("entity_type")
  entityId       String?          @map("entity_id")
  dedupeKey      String?          @map("dedupe_key")
  groupKey       String?          @map("group_key")
  groupedCount   Int              @default(1) @map("grouped_count")
  /// Null until delivered over Socket.IO (deferred during quiet hours).
  deliveredAt    DateTime?        @map("delivered_at")
  deliverAfter   DateTime?        @map("deliver_after")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, dedupeKey])
  @@index([deliverAfter])
  @@map("notifications")
}

model NotificationPreference {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  type           NotificationType
  channel        NotificationChannel
  enabled        Boolean             @default(true)
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId, type, channel])
  @@map("notification_preferences")
}

model NotificationSetting {
  userId            String   @map("user_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  quietHoursEnabled Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String   @default("22:00") @map("quiet_hours_start")
  quietHoursEnd     String   @default("07:00") @map("quiet_hours_end")
  timezone          String   @default("Asia/Kolkata")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([userId, organizationId])
  @@map("notification_settings")
}

// ---------------------------------------------------------------------------------------------
// Invitations and password resets (tokens stored hashed, single use, expiring)
// ---------------------------------------------------------------------------------------------

model UserInvitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  email          String
  tokenHash      String    @unique @map("token_hash")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationSender", fields: [invitedById], references: [id])

  @@index([userId])
  @@index([organizationId, createdAt])
  @@map("user_invitations")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — integration foundation
//
// One connection per provider per organization. Credentials are ciphertext produced by
// SecretCipherService (AES-256-GCM); there is deliberately no column that could hold a token in
// the clear, and nothing here is ever serialised straight to an API response.
// ---------------------------------------------------------------------------------------------

enum IntegrationProvider {
  GITHUB
  GITLAB
  EMAIL
  WHATSAPP
  AI
  /// Ashniva IVR. Reuses this table rather than growing a parallel one: the encrypted
  /// credentials, the webhook secret, the external account id that attributes an unauthenticated
  /// delivery to a tenant, and the idempotency index on IntegrationEvent are all already here,
  /// and a second copy of that machinery is a second thing to get wrong.
  IVR
  /// Ashniva Theme Manager, the separate product that publishes design tokens. Here for the same
  /// reason IVR is: the base URL in non-secret settings, the credential encrypted at rest, the
  /// enable switch, and a webhook secret already in place for the day the integration direction
  /// is decided to be push rather than pull. Desk stores no theme credentials anywhere else.
  THEME_MANAGER
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
  EXPIRED
}

enum SyncStatus {
  NEVER
  SUCCESS
  PARTIAL
  FAILED
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  REJECTED
}

model IntegrationConnection {
  id                     String              @id @default(uuid(7)) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  provider               IntegrationProvider
  status                 IntegrationStatus   @default(DISCONNECTED)
  enabled                Boolean             @default(true)
  displayName            String?             @map("display_name")
  /// AES-256-GCM ciphertext from SecretCipherService. Never returned by any endpoint.
  encryptedCredentials   String?             @map("encrypted_credentials")
  /// When the stored token stops working; the sync queue refreshes before this.
  credentialsExpireAt    DateTime?           @map("credentials_expire_at")
  scopes                 String[]            @default([])
  /// Shared secret used to verify inbound webhooks. Ciphertext, like the credentials.
  webhookSecretEncrypted String?             @map("webhook_secret_encrypted")
  /// Provider-side account/installation identifier. Not a secret.
  externalAccountId      String?             @map("external_account_id")
  /// Non-secret provider settings only (base URL, sender name, …).
  settings               Json                @default("{}")
  lastSyncAt             DateTime?           @map("last_sync_at")
  lastSyncStatus         SyncStatus          @default(NEVER) @map("last_sync_status")
  lastErrorAt            DateTime?           @map("last_error_at")
  /// Already redacted before it is written; safe to show an administrator.
  lastErrorMessage       String?             @map("last_error_message")
  createdById            String              @map("created_by_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  deletedAt              DateTime?           @map("deleted_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  createdBy       User               @relation("IntegrationCreator", fields: [createdById], references: [id])
  events          IntegrationEvent[]
  repositoryLinks RepositoryLink[]

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  @@map("integration_connections")
}

/// One row per inbound webhook. The body is never stored — only a digest, which is enough to
/// recognise a replay without keeping customer data. The unique constraint below IS the
/// duplicate protection.
model IntegrationEvent {
  id                String                 @id @default(uuid(7)) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  connectionId      String?                @map("connection_id") @db.Uuid
  provider          IntegrationProvider
  /// The provider's own event id (GitHub X-GitHub-Delivery, GitLab X-Gitlab-Event-UUID, …).
  externalEventId   String                 @map("external_event_id")
  eventType         String                 @map("event_type")
  status            IntegrationEventStatus @default(RECEIVED)
  signatureVerified Boolean                @default(false) @map("signature_verified")
  attempts          Int                    @default(0)
  lastError         String?                @map("last_error")
  /// SHA-256 of the raw body.
  payloadDigest     String                 @map("payload_digest")
  receivedAt        DateTime               @default(now()) @map("received_at")
  processedAt       DateTime?              @map("processed_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  connection   IntegrationConnection? @relation(fields: [connectionId], references: [id])

  /// Per tenant: two organizations can receive the same delivery id for the same shared
  /// repository, and a global key let one suppress the other's event as a duplicate.
  @@unique([organizationId, provider, externalEventId], map: "ux_integration_events_org_provider_event")
  @@index([organizationId, receivedAt])
  @@index([status])
  @@map("integration_events")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — Git provider integration
// ---------------------------------------------------------------------------------------------

enum CodeActivityKind {
  COMMIT
  BRANCH_PUSH
  PULL_REQUEST
  REVIEW
  MERGE
  RELEASE
  TAG
}

/// A repository on a provider, linked to one project. A project may link several repositories.
model RepositoryLink {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  connectionId   String              @map("connection_id") @db.Uuid
  provider       IntegrationProvider
  /// The provider's own repository id, stable across renames.
  externalRepoId String              @map("external_repo_id")
  /// Owner (GitHub) or group path (GitLab).
  owner          String
  name           String
  defaultBranch  String              @default("main") @map("default_branch")
  /// Provider-side webhook id, so unlinking can remove it again.
  webhookId      String?             @map("webhook_id")
  linkedById     String              @map("linked_by_id") @db.Uuid
  lastSyncAt     DateTime?           @map("last_sync_at")
  lastSyncStatus SyncStatus          @default(NEVER) @map("last_sync_status")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  project      Project               @relation(fields: [projectId], references: [id])
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id])
  linkedBy     User                  @relation("RepositoryLinker", fields: [linkedById], references: [id])
  activities   CodeActivity[]
  releaseNotes ReleaseNote[]

  @@unique([connectionId, externalRepoId])
  @@index([organizationId])
  @@index([projectId])
  /// The webhook resolves its tenant by this pair, before any authentication.
  @@index([provider, externalRepoId])
  @@map("repository_links")
}

/// One row per commit, push, pull/merge request, review, merge or release seen on a linked
/// repository. Development activity is internal: it is never exposed through the client portal.
model CodeActivity {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  repositoryLinkId String           @map("repository_link_id") @db.Uuid
  kind             CodeActivityKind
  /// Provider id for this item: commit sha, PR/MR number, release tag.
  externalId       String           @map("external_id")
  title            String
  /// Display name from the provider; no email address is stored.
  authorName       String?          @map("author_name")
  authorExternalId String?          @map("author_external_id")
  url              String?
  branch           String?
  /// Provider state, e.g. open / merged / closed for a pull request.
  state            String?
  occurredAt       DateTime         @map("occurred_at")
  /// Resolved from a TSK-### or <CODE>-### reference in the message, branch or title.
  taskId           String?          @map("task_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id])
  repositoryLink RepositoryLink @relation(fields: [repositoryLinkId], references: [id], onDelete: Cascade)
  task           Task?          @relation(fields: [taskId], references: [id])

  @@unique([repositoryLinkId, kind, externalId])
  @@index([organizationId, occurredAt])
  @@index([taskId])
  @@map("code_activities")
}

// ---------------------------------------------------------------------------------------------
// Phase 3 — release notes
//
// A release note is the one Phase 3 artefact that crosses the internal/client boundary, so the
// split is explicit in the columns: internalNotes never leaves the provider, clientSummary and
// items flagged clientVisible are what the portal reads, and only a PUBLISHED note is readable
// there at all.
// ---------------------------------------------------------------------------------------------

enum ReleaseNoteStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CANCELLED
}

enum ReleaseNoteItemKind {
  TASK
  TICKET
  CLIENT_UPDATE
  CODE_ACTIVITY
  MANUAL
}

enum ReleaseNoteSource {
  /// Built by the draft generator from delivered work.
  GENERATED
  /// Typed by a person.
  MANUAL
}

model ReleaseNote {
  id                   String            @id @default(uuid(7)) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  clientOrganizationId String            @map("client_organization_id") @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  repositoryLinkId     String?           @map("repository_link_id") @db.Uuid
  version              String
  releaseDate          DateTime          @map("release_date") @db.Date
  status               ReleaseNoteStatus @default(DRAFT)
  /// Inclusive start of the reporting period the draft was generated from.
  periodStart          DateTime?         @map("period_start") @db.Date
  /// Exclusive end of the reporting period.
  periodEnd            DateTime?         @map("period_end") @db.Date
  /// Provider-only. Never mapped into a portal response.
  internalNotes        String?           @map("internal_notes")
  /// What the client reads.
  clientSummary        String?           @map("client_summary")
  generatedAt          DateTime?         @map("generated_at")
  createdById          String            @map("created_by_id") @db.Uuid
  submittedById        String?           @map("submitted_by_id") @db.Uuid
  submittedAt          DateTime?         @map("submitted_at")
  approvedById         String?           @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?         @map("approved_at")
  publishedById        String?           @map("published_by_id") @db.Uuid
  publishedAt          DateTime?         @map("published_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  organization       Organization         @relation("ReleaseNoteOwner", fields: [organizationId], references: [id])
  clientOrganization Organization         @relation("ReleaseNoteClient", fields: [clientOrganizationId], references: [id])
  project            Project              @relation(fields: [projectId], references: [id])
  repositoryLink     RepositoryLink?      @relation(fields: [repositoryLinkId], references: [id])
  createdBy          User                 @relation("ReleaseNoteCreator", fields: [createdById], references: [id])
  approvedBy         User?                @relation("ReleaseNoteApprover", fields: [approvedById], references: [id])
  publishedBy        User?                @relation("ReleaseNotePublisher", fields: [publishedById], references: [id])
  items              ReleaseNoteItem[]
  history            ReleaseNoteHistory[]

  releases Release[]

  @@unique([projectId, version])
  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@map("release_notes")
}

/// One line of a release note. `refId` points at the source row so regeneration can recognise
/// what it already has; `clientVisible` decides whether the portal sees the line at all.
model ReleaseNoteItem {
  id            String              @id @default(uuid(7)) @db.Uuid
  releaseNoteId String              @map("release_note_id") @db.Uuid
  kind          ReleaseNoteItemKind
  source        ReleaseNoteSource   @default(GENERATED)
  /// Null for a manual line, which has no source row.
  refId         String?             @map("ref_id") @db.Uuid
  /// Provider-side id for a code activity (commit sha, PR number), when that is the source.
  externalRef   String?             @map("external_ref")
  /// "kind:refId:externalRef", written by the repository. A plain unique index over the three
  /// parts would not work: refId and externalRef are null for most items, and Postgres treats
  /// nulls as distinct, so duplicates would slip through. This column is never null.
  identity      String
  label         String
  /// Rewritten for the client where the source wording is too internal.
  clientLabel   String?             @map("client_label")
  clientVisible Boolean             @default(true) @map("client_visible")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")

  releaseNote ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)

  @@unique([releaseNoteId, identity])
  @@index([releaseNoteId, sortOrder])
  @@map("release_note_items")
}

model ReleaseNoteHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  releaseNoteId String             @map("release_note_id") @db.Uuid
  fromStatus    ReleaseNoteStatus? @map("from_status")
  toStatus      ReleaseNoteStatus  @map("to_status")
  note          String?
  changedById   String             @map("changed_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  releaseNote ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("ReleaseNoteHistoryActor", fields: [changedById], references: [id])

  @@index([releaseNoteId, createdAt])
  @@map("release_note_history")
}

enum OutboundMessageStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  /// Deliberately not sent: the channel was off for this tenant, or the recipient opted out.
  SKIPPED
}

/// SMTP transport security. Kept as an enum so a settings form cannot store a typo.
enum EmailEncryption {
  NONE
  STARTTLS
  TLS
}

/**
 * One outbound email or WhatsApp message.
 * Shared by both channels rather than one table each: the delivery lifecycle, the retry
 * accounting and the idempotency rule are identical, and a single history is what an
 * administrator actually wants to read.
 */
model OutboundMessage {
  id                String                @id @default(uuid(7)) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  channel           NotificationChannel
  /// Set when the message came from a notification; null for a test send.
  recipientUserId   String?               @map("recipient_user_id") @db.Uuid
  /// Address or phone number as it was at send time, so history stays readable after a change.
  /// Masked by the mapper before it reaches any response.
  destination       String
  /// Template key from packages/types. A string rather than an enum: the set grows often.
  template          String
  subject           String?
  status            OutboundMessageStatus @default(QUEUED)
  /**
   * Identifies the business event and recipient. The unique index below is what stops the same
   * event emailing someone twice when a job is retried or a webhook redelivered.
   */
  idempotencyKey    String                @map("idempotency_key")
  /// Provider-side id, for correlating with a delivery receipt.
  providerMessageId String?               @map("provider_message_id")
  attempts          Int                   @default(0)
  /// Already redacted before it is written; safe to show an administrator.
  lastError         String?               @map("last_error")
  /**
   * The rendered request this row stands for, so a failed message can be sent again.
   * The title, body and link live in the queue payload, not in the columns above, and a job is
   * gone once it has run — without this a resend would have to invent the content. Nullable
   * because rows written before resend existed have none, and those refuse a resend rather than
   * guess. Never contains a credential: it is the same rendered text the recipient was to be sent.
   */
  payload           Json?
  /// Set when this row was created by resending an earlier one, for the audit trail.
  resentFromId      String?               @map("resent_from_id") @db.Uuid
  queuedAt          DateTime              @default(now()) @map("queued_at")
  sentAt            DateTime?             @map("sent_at")
  failedAt          DateTime?             @map("failed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  recipient    User?        @relation("OutboundMessageRecipient", fields: [recipientUserId], references: [id])

  @@unique([organizationId, channel, idempotencyKey])
  @@index([organizationId, channel, queuedAt])
  @@index([organizationId, status])
  /// The stalled-claim sweep runs across every tenant, so it has no organization to lead with
  /// and the index above cannot serve it. Without this it is a sequential scan of the whole
  /// table every five minutes, on a table that only grows.
  @@index([status, updatedAt])
  @@map("outbound_messages")
}

// ---------------------------------------------------------------------------------------------
// Billing and invoicing
//
// Every money column is `Decimal`, never a float. Amounts are Decimal(14, 2) — paise, up to
// twelve digits of rupees. Unit prices carry four places so a per-hour rate is not rounded
// before it is multiplied, and quantities carry three.
//
// This module prepares invoices and records their tax breakdown. It is not a GST filing system.
// ---------------------------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  /// Issued, past its due date and not settled. Derived, but stored so lists can filter on it.
  OVERDUE
  /// Withdrawn before it was ever sent. A draft or a freshly issued invoice.
  CANCELLED
  /// Cancelled after the fact, keeping the number in the sequence. Never reused.
  VOID
}

/// Whether the price entered on a line already contains GST.
enum TaxTreatment {
  EXCLUSIVE
  INCLUSIVE
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE
  EXPORT
  EXEMPT
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  CASH
  OTHER
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// What produced an invoice line, when it came from somewhere in the system.
enum InvoiceLineSource {
  MANUAL
  MILESTONE
  SUPPORT_HOURS
  CHANGE_REQUEST
  CONTRACT
}

/**
 * A tenant's own billing identity: who the invoice is *from*.
 * One per organization. Holds the numbering state as well as the details, so issuing an invoice
 * touches a single row and the sequence cannot drift from the prefix it belongs to.
 */
model BillingProfile {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  legalName    String  @map("legal_name")
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  /// State name as it should be printed.
  state        String
  /// Two-digit GST state code. Decides intra- versus inter-state treatment.
  stateCode    String  @map("state_code")
  postalCode   String  @map("postal_code")
  country      String  @default("India")

  gstin String?
  pan   String?
  email String
  phone String?

  currency            String       @default("INR")
  /// Days from issue to due date, unless the invoice overrides it.
  paymentTermsDays    Int          @default(30) @map("payment_terms_days")
  defaultTaxRate      Decimal      @default(18) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultTaxTreatment TaxTreatment @default(EXCLUSIVE) @map("default_tax_treatment")
  /// Round the payable total to a whole rupee and show the difference as its own line.
  roundTotals         Boolean      @default(true) @map("round_totals")

  /// "INV" gives INV/2026-27/0001.
  invoicePrefix           String @default("INV") @map("invoice_prefix")
  /**
   * The next number to hand out, per financial year. Incremented inside the same transaction
   * that creates the invoice, so two concurrent requests cannot take the same one.
   */
  nextSequence            Int    @default(1) @map("next_sequence")
  /// The financial year `nextSequence` belongs to; a new year resets the sequence to 1.
  sequenceYear            String @default("") @map("sequence_year")
  /// 4 = April, the Indian financial year. Configurable for other jurisdictions.
  financialYearStartMonth Int    @default(4) @map("financial_year_start_month")

  /// Stored, but no document prints either yet — see the note on `InvoicePdfService`. Neither is
  /// validated against the organization's files on save, so a renderer must resolve the id
  /// through the organization-scoped file lookup before it reads anything.
  logoFileId      String? @map("logo_file_id") @db.Uuid
  signatureFileId String? @map("signature_file_id") @db.Uuid

  /// Printed on the invoice: account number, IFSC, UPI id.
  bankDetails   String? @map("bank_details")
  /// Printed under the totals.
  terms         String?
  /// Never printed and never sent to a client.
  internalNotes String? @map("internal_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization  Organization @relation("BillingProfileOwner", fields: [organizationId], references: [id])
  logoFile      File?        @relation("BillingProfileLogo", fields: [logoFileId], references: [id])
  signatureFile File?        @relation("BillingProfileSignature", fields: [signatureFileId], references: [id])

  @@map("billing_profiles")
}

/**
 * Who an invoice is *to*: the provider's record of one client's billing particulars.
 * CGST Rule 46 requires the recipient's name, address and GSTIN on a tax invoice, and until this
 * table there was nowhere to hold them. `buildInvoiceSnapshot` read the client's own
 * `BillingProfile`, which the row-level-security policy on that table can never return — a
 * provider asking for a row whose `organization_id` is somebody else's — so every B2B invoice
 * went out with an empty "Bill to" block.
 * The row belongs to the **provider**: `organizationId` is who is invoicing, and
 * `clientOrganizationId` is who is invoiced. That is what makes ordinary tenant isolation enough,
 * with no change to any existing policy: a client tenant matches neither branch and can neither
 * read nor edit how it is billed, which is the provider's record to keep.
 */
model ClientBillingProfile {
  id                   String @id @default(uuid(7)) @db.Uuid
  /// The provider raising the invoices. This tenant owns the row.
  organizationId       String @map("organization_id") @db.Uuid
  /// The client being invoiced. Never the owning tenant.
  clientOrganizationId String @map("client_organization_id") @db.Uuid

  /// The registered name to print, which is often not the organization's display name.
  legalName    String  @map("legal_name")
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  /// State name as it should be printed.
  state        String
  /**
   * Two-digit GST state code of the *recipient*, printed in the "Bill to" block.
   * It does not decide CGST/SGST versus IGST. That has one input, the invoice's own
   * `placeOfSupplyCode`, and it stays that way so the two can never disagree: a bill-to state and
   * a place of supply are allowed to differ, and the document has to be able to say so.
   */
  stateCode    String  @map("state_code")
  postalCode   String  @map("postal_code")
  country      String  @default("India")

  /// Null for an unregistered recipient, who legitimately has none.
  gstin String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /**
   * `Restrict` on both sides, stated rather than inherited: a hard delete of either organization
   * is refused instead of quietly dropping the record of how that client was invoiced. In
   * practice an organization is retired with `deletedAt`, so the row simply stays with it.
   */
  organization       Organization @relation("ClientBillingProfileOwner", fields: [organizationId], references: [id], onDelete: Restrict)
  clientOrganization Organization @relation("ClientBillingProfileClient", fields: [clientOrganizationId], references: [id], onDelete: Restrict)

  /// One record per provider per client. The provider is part of the key, not assumed.
  @@unique([organizationId, clientOrganizationId])
  @@index([clientOrganizationId])
  @@map("client_billing_profiles")
}

model Invoice {
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  clientOrganizationId String        @map("client_organization_id") @db.Uuid
  /// Sequential within the organization and financial year.
  number               Int
  /// The printed identifier, e.g. "INV/2026-27/0007". Unique per organization.
  numberLabel          String        @map("number_label")
  financialYear        String        @map("financial_year")
  status               InvoiceStatus @default(DRAFT)

  projectId       String? @map("project_id") @db.Uuid
  contractId      String? @map("contract_id") @db.Uuid
  milestoneId     String? @map("milestone_id") @db.Uuid
  changeRequestId String? @map("change_request_id") @db.Uuid

  issueDate DateTime @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date
  currency  String   @default("INR")

  /// The state the supply is treated as made in; decides CGST+SGST versus IGST.
  placeOfSupplyState String       @map("place_of_supply_state")
  placeOfSupplyCode  String       @map("place_of_supply_code")
  supplyType         SupplyType   @default(INTRA_STATE) @map("supply_type")
  taxTreatment       TaxTreatment @default(EXCLUSIVE) @map("tax_treatment")
  /// The recipient pays the tax directly, so it is shown but not collected.
  reverseCharge      Boolean      @default(false) @map("reverse_charge")

  // Every figure below is computed by the API from the line items. A total submitted by a
  // client is never trusted or stored.
  subtotal           Decimal @default(0) @db.Decimal(14, 2)
  discountTotal      Decimal @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxableValue       Decimal @default(0) @map("taxable_value") @db.Decimal(14, 2)
  cgstTotal          Decimal @default(0) @map("cgst_total") @db.Decimal(14, 2)
  sgstTotal          Decimal @default(0) @map("sgst_total") @db.Decimal(14, 2)
  igstTotal          Decimal @default(0) @map("igst_total") @db.Decimal(14, 2)
  taxTotal           Decimal @default(0) @map("tax_total") @db.Decimal(14, 2)
  roundingAdjustment Decimal @default(0) @map("rounding_adjustment") @db.Decimal(14, 2)
  total              Decimal @default(0) @db.Decimal(14, 2)
  amountPaid         Decimal @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balanceDue         Decimal @default(0) @map("balance_due") @db.Decimal(14, 2)
  amountInWords      String? @map("amount_in_words")

  /// Shown to the client on the document.
  notes         String?
  /// Provider only. Never printed, never returned by a portal endpoint.
  internalNotes String? @map("internal_notes")

  /**
   * Supplier and customer details frozen at the moment of issue.
   * A tax document must not change retrospectively because someone later corrected the company
   * address, so the issued invoice carries its own copy rather than joining live rows.
   */
  snapshot  Json?
  pdfFileId String? @map("pdf_file_id") @db.Uuid

  issuedById     String?   @map("issued_by_id") @db.Uuid
  issuedAt       DateTime? @map("issued_at")
  cancelledById  String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at")
  cancelReason   String?   @map("cancel_reason")
  voidedById     String?   @map("voided_by_id") @db.Uuid
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  lastReminderAt DateTime? @map("last_reminder_at")

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization       Organization   @relation("InvoiceOwner", fields: [organizationId], references: [id])
  clientOrganization Organization   @relation("InvoiceClient", fields: [clientOrganizationId], references: [id])
  project            Project?       @relation(fields: [projectId], references: [id])
  contract           Contract?      @relation(fields: [contractId], references: [id])
  milestone          Milestone?     @relation(fields: [milestoneId], references: [id])
  changeRequest      ChangeRequest? @relation(fields: [changeRequestId], references: [id])
  pdfFile            File?          @relation("InvoicePdf", fields: [pdfFileId], references: [id])
  createdBy          User           @relation("InvoiceCreator", fields: [createdById], references: [id])
  issuedBy           User?          @relation("InvoiceIssuer", fields: [issuedById], references: [id])

  lineItems    InvoiceLineItem[]
  taxBreakdown InvoiceTaxBreakdown[]
  allocations  PaymentAllocation[]
  history      InvoiceHistory[]
  creditNotes  CreditNote[]

  @@unique([organizationId, numberLabel])
  @@index([organizationId, status, dueDate])
  @@index([clientOrganizationId, status])
  @@index([organizationId, issueDate])
  /// The files row-level-security policy looks an invoice up by its PDF, not the other way round.
  @@index([pdfFileId])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(uuid(7)) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  /// Display order, dense from 0.
  position  Int

  description String
  /// Harmonised code for goods (HSN) or services (SAC). Empty rather than null so the tax
  /// breakdown's unique index behaves — Postgres treats nulls as distinct.
  hsnSac      String @default("") @map("hsn_sac")

  quantity        Decimal @db.Decimal(12, 3)
  unit            String  @default("Nos")
  unitPrice       Decimal @map("unit_price") @db.Decimal(14, 4)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)

  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  taxableValue Decimal @map("taxable_value") @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(14, 2)

  source      InvoiceLineSource @default(MANUAL)
  /// The row this line was generated from, when it was generated.
  sourceRefId String?           @map("source_ref_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("invoice_line_items")
}

/**
 * The per-rate summary printed beneath the line items.
 * Stored rather than recomputed on read, because an issued invoice must show the figures it was
 * issued with even if the calculation changes later.
 */
model InvoiceTaxBreakdown {
  id        String @id @default(uuid(7)) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  hsnSac       String  @default("") @map("hsn_sac")
  taxableValue Decimal @map("taxable_value") @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  totalTax     Decimal @map("total_tax") @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, taxRate, hsnSac])
  @@map("invoice_tax_breakdowns")
}

/**
 * Money received from a client.
 * A payment exists independently of the invoices it settles: one transfer often covers several,
 * and a client sometimes pays before an invoice is raised. `unallocatedAmount` is what is left
 * to apply.
 */
model Payment {
  id                   String @id @default(uuid(7)) @db.Uuid
  organizationId       String @map("organization_id") @db.Uuid
  clientOrganizationId String @map("client_organization_id") @db.Uuid

  /// The bank or gateway reference. Unique per organization, so the same transfer cannot be
  /// recorded twice by two people looking at the same statement.
  reference         String
  method            PaymentMethod @default(BANK_TRANSFER)
  paidAt            DateTime      @map("paid_at")
  amount            Decimal       @db.Decimal(14, 2)
  /// Amount not yet applied to an invoice.
  unallocatedAmount Decimal       @map("unallocated_amount") @db.Decimal(14, 2)
  currency          String        @default("INR")

  notes         String?
  /// Provider only.
  internalNotes String? @map("internal_notes")

  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization       Organization        @relation("PaymentOwner", fields: [organizationId], references: [id])
  clientOrganization Organization        @relation("PaymentClient", fields: [clientOrganizationId], references: [id])
  recordedBy         User                @relation("PaymentRecorder", fields: [recordedById], references: [id])
  allocations        PaymentAllocation[]

  @@unique([organizationId, reference])
  @@index([organizationId, paidAt])
  @@index([clientOrganizationId, paidAt])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid(7)) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(14, 2)

  allocatedById String   @map("allocated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  /// One row per payment-invoice pair; applying more is an update, not a second row.
  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/**
 * What happened to an invoice, and what it said at the time.
 * `documentSnapshot` is why this exists: when a permitted change alters an issued invoice, the
 * previous financial document is kept rather than silently replaced.
 */
model InvoiceHistory {
  id               String         @id @default(uuid(7)) @db.Uuid
  invoiceId        String         @map("invoice_id") @db.Uuid
  fromStatus       InvoiceStatus? @map("from_status")
  toStatus         InvoiceStatus  @map("to_status")
  note             String?
  /// The invoice's figures and details as they stood. Provider only.
  documentSnapshot Json?          @map("document_snapshot")
  /// The PDF that was current at this point, kept so a superseded document stays readable.
  pdfFileId        String?        @map("pdf_file_id") @db.Uuid

  changedById String   @map("changed_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy User    @relation("InvoiceHistoryActor", fields: [changedById], references: [id])
  pdfFile   File?   @relation("InvoiceHistoryPdf", fields: [pdfFileId], references: [id])

  @@index([invoiceId, createdAt])
  @@map("invoice_history")
}

/**
 * A reduction against an issued invoice.
 * Deliberately minimal in this slice: it records the amount, its tax split and why, and reduces
 * the balance due. It does not attempt the full credit-note lifecycle.
 */
model CreditNote {
  id                   String           @id @default(uuid(7)) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  clientOrganizationId String           @map("client_organization_id") @db.Uuid
  invoiceId            String           @map("invoice_id") @db.Uuid
  number               Int
  numberLabel          String           @map("number_label")
  financialYear        String           @map("financial_year")
  status               CreditNoteStatus @default(DRAFT)

  issueDate DateTime @map("issue_date") @db.Date
  reason    String

  taxableValue Decimal @map("taxable_value") @db.Decimal(14, 2)
  cgstAmount   Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount   Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount   Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)

  issuedById String?   @map("issued_by_id") @db.Uuid
  issuedAt   DateTime? @map("issued_at")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization       Organization @relation("CreditNoteOwner", fields: [organizationId], references: [id])
  clientOrganization Organization @relation("CreditNoteClient", fields: [clientOrganizationId], references: [id])
  invoice            Invoice      @relation(fields: [invoiceId], references: [id])
  createdBy          User         @relation("CreditNoteCreator", fields: [createdById], references: [id])

  @@unique([organizationId, numberLabel])
  @@index([invoiceId])
  @@index([clientOrganizationId, status])
  @@map("credit_notes")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------------------------
// AI-generated progress summaries (Phase 3)
//
// The provider is configuration, not a design decision baked into the schema: a run records which
// provider and model produced it, so the same summary can be regenerated on a different provider
// and the history still says what produced what.
// -----------------------------------------------------------------------------------------------

enum AiSummaryType {
  DEVELOPER_DAILY
  LEAD_DAILY
  PROJECT_PROGRESS
  CLIENT_WEEKLY
  RELEASE_NOTE_DRAFT
  TICKET_RESOLUTION
}

enum AiSummaryStatus {
  DRAFT
  GENERATING
  GENERATION_FAILED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CANCELLED
}

enum AiSourceKind {
  TASK
  TASK_STATUS_CHANGE
  WORK_LOG
  TICKET
  CLIENT_UPDATE
  MILESTONE
  CODE_ACTIVITY
  RELEASE_NOTE
}

enum AiGenerationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  RATE_LIMITED
  INVALID_RESPONSE
  NO_SOURCES
}

/// One generated summary, through its review workflow.
model AiSummary {
  id                   String          @id @default(uuid(7)) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  /// Set only for a summary that may reach a client. Null for internal summaries.
  clientOrganizationId String?         @map("client_organization_id") @db.Uuid
  projectId            String?         @map("project_id") @db.Uuid
  /// The person a developer or lead daily summary is about.
  subjectUserId        String?         @map("subject_user_id") @db.Uuid
  ticketId             String?         @map("ticket_id") @db.Uuid
  type                 AiSummaryType
  status               AiSummaryStatus @default(DRAFT)
  title                String
  /// Inclusive start of the reporting period the summary covers.
  periodStart          DateTime        @map("period_start") @db.Date
  /// Inclusive end of the reporting period.
  periodEnd            DateTime        @map("period_end") @db.Date
  /// What the team reads. Never mapped into a portal response.
  internalContent      String?         @map("internal_content")
  /// What would be published. Written only for a client-facing summary type.
  clientContent        String?         @map("client_content")
  /// Set when the sources were thin, so a reviewer knows the summary is not the whole picture.
  missingDataNote      String?         @map("missing_data_note")
  /// The reviewer's note when changes were requested.
  reviewNote           String?         @map("review_note")
  cancelReason         String?         @map("cancel_reason")
  /// True until a person has approved it. Displayed on every unapproved view of the text.
  isDraftOutput        Boolean         @default(true) @map("is_draft_output")
  version              Int             @default(1)
  providerName         String?         @map("provider_name")
  model                String?
  promptVersion        String?         @map("prompt_version")
  outputVersion        String?         @map("output_version")
  generatedAt          DateTime?       @map("generated_at")
  createdById          String          @map("created_by_id") @db.Uuid
  submittedById        String?         @map("submitted_by_id") @db.Uuid
  submittedAt          DateTime?       @map("submitted_at")
  approvedById         String?         @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?       @map("approved_at")
  publishedById        String?         @map("published_by_id") @db.Uuid
  publishedAt          DateTime?       @map("published_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  deletedAt            DateTime?       @map("deleted_at")

  organization       Organization       @relation("AiSummaryOwner", fields: [organizationId], references: [id])
  clientOrganization Organization?      @relation("AiSummaryClient", fields: [clientOrganizationId], references: [id])
  project            Project?           @relation(fields: [projectId], references: [id])
  subjectUser        User?              @relation("AiSummarySubject", fields: [subjectUserId], references: [id])
  ticket             Ticket?            @relation(fields: [ticketId], references: [id])
  createdBy          User               @relation("AiSummaryCreator", fields: [createdById], references: [id])
  approvedBy         User?              @relation("AiSummaryApprover", fields: [approvedById], references: [id])
  publishedBy        User?              @relation("AiSummaryPublisher", fields: [publishedById], references: [id])
  sources            AiSummarySource[]
  versions           AiSummaryVersion[]
  runs               AiGenerationRun[]

  @@index([organizationId, type, status])
  @@index([organizationId, subjectUserId, periodStart])
  @@index([clientOrganizationId, status])
  @@index([projectId, periodStart])
  @@map("ai_summaries")
}

/// A record the summary was grounded in. Written whether or not the model mentioned it.
model AiSummarySource {
  id            String       @id @default(uuid(7)) @db.Uuid
  summaryId     String       @map("summary_id") @db.Uuid
  kind          AiSourceKind
  refId         String?      @map("ref_id") @db.Uuid
  label         String
  /// The text that was actually put in the prompt, after sanitising. Provider-only.
  promptText    String?      @map("prompt_text")
  occurredAt    DateTime?    @map("occurred_at")
  /// Whether this record may inform client-visible text.
  clientVisible Boolean      @default(false) @map("client_visible")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")

  summary AiSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId, sortOrder])
  @@map("ai_summary_sources")
}

/// A previous version of the text. Regeneration writes one of these before overwriting.
model AiSummaryVersion {
  id              String          @id @default(uuid(7)) @db.Uuid
  summaryId       String          @map("summary_id") @db.Uuid
  version         Int
  status          AiSummaryStatus
  internalContent String?         @map("internal_content")
  clientContent   String?         @map("client_content")
  note            String?
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  summary   AiSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  createdBy User      @relation("AiSummaryVersionAuthor", fields: [createdById], references: [id])

  @@unique([summaryId, version])
  @@index([summaryId, version])
  @@map("ai_summary_versions")
}

/// One call to a provider: what it cost, how long it took, and how it ended.
model AiGenerationRun {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  summaryId      String?            @map("summary_id") @db.Uuid
  status         AiGenerationStatus @default(RUNNING)
  providerName   String             @map("provider_name")
  model          String?
  promptVersion  String             @map("prompt_version")
  outputVersion  String             @map("output_version")
  attempt        Int                @default(1)
  inputTokens    Int?               @map("input_tokens")
  outputTokens   Int?               @map("output_tokens")
  latencyMs      Int?               @map("latency_ms")
  failureCode    String?            @map("failure_code")
  /// Redacted before it is written. Never contains a credential or a prompt.
  failureMessage String?            @map("failure_message")
  startedAt      DateTime           @default(now()) @map("started_at")
  finishedAt     DateTime?          @map("finished_at")

  organization Organization @relation("AiGenerationRunOwner", fields: [organizationId], references: [id])
  summary      AiSummary?   @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([summaryId, startedAt])
  @@map("ai_generation_runs")
}

// -------------------------------------------------------------------------------------------
// Phase 4 — testing, staging and release workflow (implementation order 6)
//
// The vocabulary for all of this already existed in packages/types before any of it was built:
// TESTING_ASSIGNMENT_KIND, TESTING_ASSIGNMENT_STATUS, TEST_RESULT, TEST_ENVIRONMENT,
// RELEASE_STATUS and RELEASE_APPROVER_ROLE, together with the qa:* and release:* permissions and
// `projects.requires_client_uat`. These models are those contracts given tables.
// -------------------------------------------------------------------------------------------

/// QA, a retest after a fix, verification on production, or the client's own UAT.
enum TestingAssignmentKind {
  QA
  RETEST
  LIVE_VERIFICATION
  UAT
}

enum TestingAssignmentStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  /// The tester cannot proceed and has asked the developer a question.
  CLARIFICATION
  CANCELLED
}

enum TestOutcome {
  PASS
  FAIL
}

/// Automated check (GitHub Actions) outcome as carried onto a testing assignment.
enum CheckStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum TestSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestEnvironmentStatus {
  UP
  DOWN
  DEPLOYING
  UNKNOWN
}

enum CredentialRotationPolicy {
  AFTER_TEST
  DAILY
  MANUAL
}

enum CredentialAction {
  GENERATE
  REVEAL
  ROTATE
  REVOKE
}

enum UatDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum TestEnvironmentKind {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum ReleaseStatus {
  DRAFT
  APPROVAL_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  VERIFIED
  ROLLED_BACK
  FAILED
}

enum ReleaseApproverRole {
  SENIOR
  PROJECT_MANAGER
  QA_LEAD
  CLIENT
  DIRECTOR
}

enum ReleaseApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum ReleaseItemKind {
  TASK
  TICKET
  CHANGE_REQUEST
}

/**
 * One piece of testing somebody owes.
 * The same table carries internal QA, a retest after a fix, live verification on production and
 * the client's UAT, because the lifecycle is identical in each case and only the audience and the
 * environment differ. Keeping them apart would mean four state machines that have to agree.
 */
model TestingAssignment {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  projectId      String                  @map("project_id") @db.Uuid
  kind           TestingAssignmentKind
  status         TestingAssignmentStatus @default(PENDING)
  environment    TestEnvironmentKind     @default(STAGING)

  /// What is being tested. Exactly one of these is set; the check is in the service.
  taskId    String? @map("task_id") @db.Uuid
  ticketId  String? @map("ticket_id") @db.Uuid
  releaseId String? @map("release_id") @db.Uuid

  /// Null for a UAT assignment, which belongs to the client organization rather than a person.
  assignedToUserId      String?      @map("assigned_to_user_id") @db.Uuid
  clientOrganizationId  String?      @map("client_organization_id") @db.Uuid
  assignedById          String       @map("assigned_by_id") @db.Uuid
  /// The assignment payload: everything a tester needs without asking the developer.
  stagingUrl            String?      @map("staging_url")
  whatDeveloped         String?      @map("what_developed")
  whatToTest            String?      @map("what_to_test")
  acceptanceCriteria    String?      @map("acceptance_criteria")
  developerNotes        String?      @map("developer_notes")
  /// Which browsers or devices this has to be checked on.
  browserDevice         String[]     @map("browser_device")
  /// The automated-check result carried over from the pull request, when there is one.
  checksStatus          CheckStatus? @map("checks_status")
  /// The login the tester should use, if the project has one for this role.
  testAccountId         String?      @map("test_account_id") @db.Uuid
  /// Set when the tester asks a question; cleared when the developer answers.
  clarificationQuestion String?      @map("clarification_question")
  clarificationAnswer   String?      @map("clarification_answer")

  dueAt       DateTime? @map("due_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization       Organization      @relation("TestingAssignmentOwner", fields: [organizationId], references: [id])
  clientOrganization Organization?     @relation("TestingAssignmentClient", fields: [clientOrganizationId], references: [id])
  project            Project           @relation(fields: [projectId], references: [id])
  task               Task?             @relation(fields: [taskId], references: [id])
  ticket             Ticket?           @relation(fields: [ticketId], references: [id])
  release            Release?          @relation(fields: [releaseId], references: [id])
  assignedTo         User?             @relation("TestingAssignee", fields: [assignedToUserId], references: [id])
  assignedBy         User              @relation("TestingAssigner", fields: [assignedById], references: [id])
  testAccount        TestAccount?      @relation(fields: [testAccountId], references: [id])
  results            TestResult[]
  credentialGrants   CredentialGrant[]

  @@index([organizationId, status])
  @@index([assignedToUserId, status])
  @@index([projectId, kind])
  @@index([releaseId])
  @@index([clientOrganizationId, status])
  @@map("testing_assignments")
}

/**
 * A pass or a fail, with the evidence behind it.
 * Append-only: a retest is a new assignment, not an edited result. A tester who changes their
 * mind leaves both records, because "it passed on the second run" is the fact somebody later
 * needs and "it passed" alone is not.
 */
model TestResult {
  id                  String              @id @default(uuid(7)) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  assignmentId        String              @map("assignment_id") @db.Uuid
  outcome             TestOutcome
  environment         TestEnvironmentKind @default(STAGING)
  /// What the tester did and saw. Required either way; a bare "failed" helps nobody.
  whatTested          String              @map("what_tested")
  actualResult        String              @map("actual_result")
  /// Only on a failure: what is wrong, in the words the developer will read.
  failureDescription  String?             @map("failure_description")
  severity            TestSeverity?
  browserDevice       String?             @map("browser_device")
  commentForDeveloper String?             @map("comment_for_developer")
  retestRequired      Boolean             @default(false) @map("retest_required")
  /// Screenshots or logs, uploaded through the files module.
  evidenceFileId      String?             @map("evidence_file_id") @db.Uuid
  recordedById        String              @map("recorded_by_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  assignment   TestingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  evidenceFile File?             @relation("TestEvidence", fields: [evidenceFileId], references: [id])
  recordedBy   User              @relation("TestResultRecorder", fields: [recordedById], references: [id])

  @@index([assignmentId, createdAt])
  @@index([organizationId, outcome])
  @@map("test_results")
}

/**
 * A reusable login on a test environment.
 * The password is encrypted at rest with `SecretCipherService` and is never returned by an
 * ordinary read. Seeing it takes a grant, and every reveal is logged — a shared test login is
 * still a credential, and "who could see it" has to be answerable after the fact.
 */
model TestAccount {
  id               String                   @id @default(uuid(7)) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  projectId        String                   @map("project_id") @db.Uuid
  /// Which kind of environment this login is for.
  environment      TestEnvironmentKind
  /// The concrete environment, when the project has recorded one.
  environmentId    String?                  @map("environment_id") @db.Uuid
  /// The role this login stands for, e.g. "Test Admin", "Test Customer".
  label            String
  username         String
  /// Encrypted at rest. Never selected into a DTO; only `reveal` decrypts it.
  secretCiphertext String                   @map("secret_ciphertext")
  /// Anything the tester needs besides the password: an OTP route, a fixed test card.
  notes            String?
  rotationPolicy   CredentialRotationPolicy @default(AFTER_TEST) @map("rotation_policy")
  /// Optional endpoint the product exposes to reset this account's data between runs.
  resetHookUrl     String?                  @map("reset_hook_url")
  isActive         Boolean                  @default(true) @map("is_active")
  rotatedAt        DateTime?                @map("rotated_at")
  createdById      String                   @map("created_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  deletedAt        DateTime?                @map("deleted_at")

  organization    Organization          @relation(fields: [organizationId], references: [id])
  project         Project               @relation(fields: [projectId], references: [id])
  testEnvironment TestEnvironment?      @relation(fields: [environmentId], references: [id])
  createdBy       User                  @relation("TestAccountCreator", fields: [createdById], references: [id])
  grants          CredentialGrant[]
  accessLog       CredentialAccessLog[]

  testingAssignments TestingAssignment[]

  @@unique([projectId, environment, label])
  @@index([organizationId, projectId])
  @@map("test_accounts")
}

/**
 * Permission for one person to see one test account's password, until a stated time.
 * Timed rather than permanent: the point of the grant is that access ends by itself. A grant that
 * never expires is the same as putting the password in the project description.
 */
model CredentialGrant {
  id              String    @id @default(uuid(7)) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  testAccountId   String    @map("test_account_id") @db.Uuid
  grantedToUserId String    @map("granted_to_user_id") @db.Uuid
  grantedById     String    @map("granted_by_id") @db.Uuid
  /// The assignment this grant was issued for, when it came from "Send for testing".
  assignmentId    String?   @map("assignment_id") @db.Uuid
  /// Why this person needs it. Required, and shown in the access log beside every reveal.
  reason          String
  expiresAt       DateTime  @map("expires_at")
  /// First reveal. A grant issued and never used is a different fact from one that was read.
  revealedAt      DateTime? @map("revealed_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  testAccount  TestAccount           @relation(fields: [testAccountId], references: [id], onDelete: Cascade)
  assignment   TestingAssignment?    @relation(fields: [assignmentId], references: [id])
  grantedTo    User                  @relation("CredentialGrantee", fields: [grantedToUserId], references: [id])
  grantedBy    User                  @relation("CredentialGrantor", fields: [grantedById], references: [id])
  accessLog    CredentialAccessLog[]

  @@index([organizationId, expiresAt])
  @@index([grantedToUserId, expiresAt])
  @@index([testAccountId])
  @@map("credential_grants")
}

/// One line per reveal. Written before the plaintext is returned, never updated, never deleted.
model CredentialAccessLog {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  grantId        String?          @map("grant_id") @db.Uuid
  testAccountId  String           @map("test_account_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  action         CredentialAction @default(REVEAL)
  revealedAt     DateTime         @default(now()) @map("revealed_at")
  ipAddress      String?          @map("ip_address")
  userAgent      String?          @map("user_agent")

  organization Organization     @relation(fields: [organizationId], references: [id])
  grant        CredentialGrant? @relation(fields: [grantId], references: [id])
  testAccount  TestAccount      @relation(fields: [testAccountId], references: [id], onDelete: Cascade)
  user         User             @relation("CredentialRevealer", fields: [userId], references: [id])

  @@index([organizationId, revealedAt])
  @@index([testAccountId, revealedAt])
  @@map("credential_access_log")
}

/**
 * A version going out, and everything that had to be true before it could.
 * The status is the gate: a release cannot be published from DRAFT, and the checks a project
 * insists on live in `ProjectReleasePolicy` rather than in the publish handler, so a project that
 * needs client UAT and one that does not run the same code.
 */
model Release {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  /// e.g. "2026.09.1". Unique per project so a version cannot be shipped twice.
  version        String
  title          String
  status         ReleaseStatus       @default(DRAFT)
  environment    TestEnvironmentKind @default(PRODUCTION)
  /// Internal plan: what is going out, in what order, what to watch.
  notes          String?

  scheduledFor   DateTime? @map("scheduled_for")
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Uuid
  verifiedAt     DateTime? @map("verified_at")
  rolledBackAt   DateTime? @map("rolled_back_at")
  /// Required when rolling back or failing: an unexplained rollback is the one nobody learns from.
  rollbackReason String?   @map("rollback_reason")
  failureReason  String?   @map("failure_reason")

  /// The Phase 3 generated note published alongside this release, when there is one.
  releaseNoteId String? @map("release_note_id") @db.Uuid

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  project      Project             @relation(fields: [projectId], references: [id])
  createdBy    User                @relation("ReleaseCreator", fields: [createdById], references: [id])
  publishedBy  User?               @relation("ReleasePublisher", fields: [publishedById], references: [id])
  releaseNote  ReleaseNote?        @relation(fields: [releaseNoteId], references: [id])
  items        ReleaseItem[]
  approvals    ReleaseApproval[]
  testing      TestingAssignment[]
  history      ReleaseHistory[]

  uatRequests UatRequest[]

  rcaReports    RcaReport[]
  incidentLinks IncidentLink[]

  @@unique([projectId, version])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([organizationId, scheduledFor])
  @@map("releases")
}

/// One task, ticket or change request included in a release.
model ReleaseItem {
  id              String          @id @default(uuid(7)) @db.Uuid
  releaseId       String          @map("release_id") @db.Uuid
  kind            ReleaseItemKind
  taskId          String?         @map("task_id") @db.Uuid
  ticketId        String?         @map("ticket_id") @db.Uuid
  changeRequestId String?         @map("change_request_id") @db.Uuid
  position        Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")

  release       Release        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id])
  ticket        Ticket?        @relation(fields: [ticketId], references: [id])
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id])

  @@unique([releaseId, taskId])
  @@unique([releaseId, ticketId])
  @@unique([releaseId, changeRequestId])
  @@index([releaseId, position])
  @@map("release_items")
}

/**
 * One required sign-off on a release.
 * Rows are created from the project's policy when approval is requested, so the set of approvers
 * is fixed at that moment. Changing the policy afterwards does not silently add or remove a
 * signature from a release already in flight.
 */
model ReleaseApproval {
  id             String                  @id @default(uuid(7)) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  releaseId      String                  @map("release_id") @db.Uuid
  approverRole   ReleaseApproverRole     @map("approver_role")
  decision       ReleaseApprovalDecision @default(PENDING)
  /// Who actually decided. Null while pending.
  approverUserId String?                 @map("approver_user_id") @db.Uuid
  note           String?
  decidedAt      DateTime?               @map("decided_at")
  createdAt      DateTime                @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  release      Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  approver     User?        @relation("ReleaseApprover", fields: [approverUserId], references: [id])

  @@unique([releaseId, approverRole])
  @@index([organizationId, decision])
  @@map("release_approvals")
}

/// Every status change on a release, with who and why. The audit an auditor actually reads.
model ReleaseHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  releaseId   String         @map("release_id") @db.Uuid
  fromStatus  ReleaseStatus? @map("from_status")
  toStatus    ReleaseStatus  @map("to_status")
  note        String?
  changedById String         @map("changed_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  changedBy User    @relation("ReleaseHistoryAuthor", fields: [changedById], references: [id])

  @@index([releaseId, createdAt])
  @@map("release_history")
}

/**
 * What a project insists on before a release may go out.
 * One row per project, created on demand with safe defaults. The gates are data rather than code
 * so that a project can require client UAT without a deployment, and so the publish path reads
 * the same for every project.
 */
model ProjectReleasePolicy {
  id                        String                @id @default(uuid(7)) @db.Uuid
  organizationId            String                @map("organization_id") @db.Uuid
  projectId                 String                @unique @map("project_id") @db.Uuid
  /// Which roles must sign off. Empty means no approval step.
  approverRoles             ReleaseApproverRole[] @map("approver_roles")
  /// Every QA and retest assignment on the release must have passed.
  requiresQaPass            Boolean               @default(true) @map("requires_qa_pass")
  /// The client's UAT assignment must have passed.
  requiresClientUat         Boolean               @default(false) @map("requires_client_uat")
  /// A live-verification assignment must pass before the release counts as VERIFIED.
  requiresLiveVerification  Boolean               @default(true) @map("requires_live_verification")
  /// Publishing asks the operator to type the version back. Off for low-risk projects.
  requiresTypedConfirmation Boolean               @default(true) @map("requires_typed_confirmation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@map("project_release_policy")
}

/**
 * A deployed place a tester can actually reach.
 * Separate from the `TestEnvironmentKind` enum on an assignment: the enum says *which kind* is
 * being tested, this row says where it is, what is on it and whether it is up. A project can have
 * one staging environment and several development ones.
 */
model TestEnvironment {
  id                    String                @id @default(uuid(7)) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  projectId             String                @map("project_id") @db.Uuid
  kind                  TestEnvironmentKind
  url                   String
  status                TestEnvironmentStatus @default(UNKNOWN)
  deployedVersion       String?               @map("deployed_version")
  deployedAt            DateTime?             @map("deployed_at")
  /// Name of the matching GitHub environment, when deployments are reported by webhook.
  githubEnvironmentName String?               @map("github_environment_name")

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id])
  createdBy    User          @relation("TestEnvironmentCreator", fields: [createdById], references: [id])
  testAccounts TestAccount[]

  @@unique([projectId, kind, url])
  @@index([organizationId, projectId])
  @@map("test_environments")
}

/**
 * What the client is asked to sign off, in their own language.
 * Deliberately its own table rather than a flavour of `ApprovalRequest`: a UAT decision carries a
 * plain-language summary, a preview link and a checklist, and it must never be able to surface a
 * staging credential, a pull request or another client's ticket. Keeping the shape separate is
 * what makes that guarantee checkable.
 */
model UatRequest {
  id                   String      @id @default(uuid(7)) @db.Uuid
  organizationId       String      @map("organization_id") @db.Uuid
  clientOrganizationId String      @map("client_organization_id") @db.Uuid
  releaseId            String?     @map("release_id") @db.Uuid
  taskId               String?     @map("task_id") @db.Uuid
  /// No jargon, no internal detail. This is the whole of what the client is shown.
  summaryPlain         String      @map("summary_plain")
  previewUrl           String?     @map("preview_url")
  checklist            String[]
  status               UatDecision @default(PENDING)
  decidedById          String?     @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?   @map("decided_at")
  note                 String?

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization       Organization @relation("UatRequestOwner", fields: [organizationId], references: [id])
  clientOrganization Organization @relation("UatRequestClient", fields: [clientOrganizationId], references: [id])
  release            Release?     @relation(fields: [releaseId], references: [id])
  task               Task?        @relation(fields: [taskId], references: [id])
  createdBy          User         @relation("UatRequestCreator", fields: [createdById], references: [id])
  decidedBy          User?        @relation("UatRequestDecider", fields: [decidedById], references: [id])

  comments UatComment[]

  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@index([releaseId])
  @@map("uat_requests")
}

/**
 * A message on a UAT request, from either side.
 * The client asks a question and the provider answers it here, so a sign-off that needed a
 * conversation keeps the conversation attached to it. `fromClient` is stored rather than derived
 * from the author's organization, because the author's memberships can change later and a
 * transcript that re-attributes itself is worse than no transcript.
 */
model UatComment {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uatRequestId   String   @map("uat_request_id") @db.Uuid
  body           String
  authorId       String   @map("author_id") @db.Uuid
  fromClient     Boolean  @map("from_client")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  uatRequest   UatRequest   @relation(fields: [uatRequestId], references: [id], onDelete: Cascade)
  author       User         @relation("UatCommentAuthor", fields: [authorId], references: [id])

  @@index([uatRequestId, createdAt])
  @@map("uat_comments")
}

// ---------------------------------------------------------------------------------------------
// Support ownership, working hours and availability (package 8a)
//
// Four tables that together answer the two questions the routing engine will ask of every
// candidate: *should* this person be working, and *are* they available. They are separate records
// because they change on completely different clocks — ownership when the team changes, a rota
// when somebody's contract changes, availability many times a day and mostly from Ashniva HR.
// One table would have made every attendance ping rewrite the project's support configuration.
// ---------------------------------------------------------------------------------------------

enum AvailabilityStatus {
  AVAILABLE
  ON_LEAVE
  OUT_OF_HOURS
  AT_LIMIT
}

enum AvailabilitySource {
  MANUAL
  HR
  SCHEDULE
  WORKLOAD
}

enum OnCallSource {
  MANUAL
  ROTATION
}

/// A person's normal working week: the rota, not what they are doing right now.
///
/// Times are minutes from midnight in `timezone` rather than instants, because "09:30 in
/// Asia/Kolkata" stays correct across a daylight-saving boundary and a stored UTC time does not.
/// `endMinute <= startMinute` means a shift that runs past midnight.
model UserWorkSchedule {
  userId         String   @id @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// `Date.getUTCDay()` numbers: Sunday is 0. Empty means no working days are configured.
  workingDays    Int[]    @map("working_days")
  startMinute    Int      @map("start_minute")
  endMinute      Int      @map("end_minute")
  timezone       String   @default("Asia/Kolkata")
  /// Open tickets this person may hold before the router stops adding to them. Null = no ceiling.
  workloadLimit  Int?     @map("workload_limit")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedById    String?  @map("updated_by_id") @db.Uuid

  user         User         @relation("WorkScheduleUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  updatedBy    User?        @relation("WorkScheduleEditor", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@map("user_work_schedules")
}

/// Whether somebody is available right now, and how Desk came to think so.
///
/// One row per person, overwritten as the day goes on. `source` and `updatedAt` matter as much as
/// `status`: an attendance ping from this morning is not evidence about this evening, and the
/// router has to be able to tell "HR says they are working" from "we fell back to the rota".
/// Ashniva HR writes here through the API; Desk never reads HR's database.
model UserAvailability {
  userId         String             @id @map("user_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  status         AvailabilityStatus
  source         AvailabilitySource
  /// When the state stops applying — the end of a leave. Null means until something replaces it.
  until          DateTime?
  note           String?
  updatedAt      DateTime           @updatedAt @map("updated_at")
  updatedById    String?            @map("updated_by_id") @db.Uuid

  user         User         @relation("AvailabilityUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  updatedBy    User?        @relation("AvailabilityEditor", fields: [updatedById], references: [id])

  @@index([organizationId, status])
  @@map("user_availability")
}

/// Exceptional cover for one project on one date.
///
/// Neither a rota nor a live state: it is the reason somebody outside their normal hours may still
/// be the right person to route to, which is exactly what on-call means.
model OnCallSchedule {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  onDate         DateTime     @map("on_date") @db.Date
  userId         String       @map("user_id") @db.Uuid
  backupUserId   String?      @map("backup_user_id") @db.Uuid
  source         OnCallSource @default(MANUAL)
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  createdById    String       @map("created_by_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation("OnCallUser", fields: [userId], references: [id])
  backupUser   User?        @relation("OnCallBackup", fields: [backupUserId], references: [id])
  createdBy    User         @relation("OnCallCreator", fields: [createdById], references: [id])

  /// One cover entry per project per day: two would make "who is on call" ambiguous.
  @@unique([projectId, onDate])
  @@index([organizationId, onDate])
  @@map("on_call_schedule")
}

/// Who covers a project's support, in the order the router will try them.
///
/// The named roles are the Architecture Plan §19.1 chain — module owner, then primary, then
/// on-call, then backup. `moduleOwners` is the first step: a map from a module or work area to the
/// person who owns it, so a ticket about billing reaches whoever owns billing rather than whoever
/// happens to be next in the list.
model SupportOwnership {
  projectId          String   @id @map("project_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  primaryDeveloperId String?  @map("primary_developer_id") @db.Uuid
  backupDeveloperId  String?  @map("backup_developer_id") @db.Uuid
  seniorId           String?  @map("senior_id") @db.Uuid
  testerId           String?  @map("tester_id") @db.Uuid
  supportExecutiveId String?  @map("support_executive_id") @db.Uuid
  /// Work area or module → user id. Kept as JSON rather than a table because it is read whole,
  /// written whole, and never queried by value.
  moduleOwners       Json     @default("{}") @map("module_owners")
  /// Project-level ceiling, used when a person has no limit of their own.
  workloadLimit      Int?     @map("workload_limit")
  /// Minutes an assignee has to acknowledge before the ticket escalates (§19.1 default: 15).
  ackMinutes         Int      @default(15) @map("ack_minutes")
  /// Minutes after that before it escalates again.
  escalationMinutes  Int      @default(30) @map("escalation_minutes")
  /// Ticket types that go straight to a developer instead of the support queue.
  directTypes        String[] @map("direct_types")
  /// Per project, because one client may want the router and another may not. Default on: a
  /// project that configured ownership meant it to be used.
  autoRouteEnabled   Boolean  @default(true) @map("auto_route_enabled")
  /// Where a ticket goes when the whole chain came up empty. Null means the support queue.
  fallbackUserId     String?  @map("fallback_user_id") @db.Uuid
  /// How many *distinct client organizations* must report the same fault before a problem is
  /// opened automatically. Counted in clients, never in tickets: three reports from one client is
  /// one unhappy client, three from three is a fault in the product.
  duplicateThreshold Int      @default(3) @map("duplicate_threshold")
  /// Whether duplicate suggestions are offered on this project's tickets at all.
  similarityEnabled  Boolean  @default(true) @map("similarity_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedById        String?  @map("updated_by_id") @db.Uuid

  organization     Organization @relation(fields: [organizationId], references: [id])
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  primaryDeveloper User?        @relation("SupportPrimary", fields: [primaryDeveloperId], references: [id])
  backupDeveloper  User?        @relation("SupportBackup", fields: [backupDeveloperId], references: [id])
  senior           User?        @relation("SupportSenior", fields: [seniorId], references: [id])
  tester           User?        @relation("SupportTester", fields: [testerId], references: [id])
  supportExecutive User?        @relation("SupportExecutive", fields: [supportExecutiveId], references: [id])
  fallbackUser     User?        @relation("SupportFallback", fields: [fallbackUserId], references: [id])
  updatedBy        User?        @relation("SupportOwnershipEditor", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@map("support_ownership")
}

// ---------------------------------------------------------------------------------------------
// Support routing (package 8b)
// ---------------------------------------------------------------------------------------------

enum RoutingOutcome {
  AUTO_ASSIGNED
  SUPPORT_QUEUE
  DISABLED
  MANUAL
}

enum AssignmentType {
  AUTOMATIC
  MANUAL
  NONE
}

enum RoutingRole {
  MODULE_OWNER
  PRIMARY_DEVELOPER
  ON_CALL
  BACKUP_DEVELOPER
  SENIOR
  SUPPORT_EXECUTIVE
}

enum RoutingSkipReason {
  ON_LEAVE
  OUT_OF_HOURS
  AT_WORKLOAD_LIMIT
  NOT_PROJECT_MEMBER
  WORK_AREA_MISMATCH
  NOT_CONFIGURED
  ALREADY_CONSIDERED
  INACTIVE
  IS_REQUESTER
  PREVIOUSLY_ASSIGNED
}

/// Where routing left one ticket, and the two timers that act on it.
///
/// A side table rather than columns on `tickets`: this is written by a background sweep every
/// couple of minutes and read by two narrow indexed queries, and it would otherwise widen the
/// hottest table in the product for the sake of six mostly-null columns.
model TicketRoutingState {
  ticketId             String         @id @map("ticket_id") @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  outcome              RoutingOutcome @map("outcome")
  assignmentType       AssignmentType @default(NONE) @map("assignment_type")
  /// Which pass of the router produced this. Incremented on every re-route, and the number the
  /// conditional update matches on so two concurrent routers cannot both win.
  attempt              Int            @default(0)
  policyVersion        Int            @default(1) @map("policy_version")
  routedAt             DateTime?      @map("routed_at")
  /// The acknowledgement timer. Distinct from the SLA response clock: this one asks "did anybody
  /// pick this up", the SLA asks "did the client get an answer".
  acknowledgeDueAt     DateTime?      @map("acknowledge_due_at")
  acknowledgedAt       DateTime?      @map("acknowledged_at")
  acknowledgedById     String?        @map("acknowledged_by_id") @db.Uuid
  escalationDueAt      DateTime?      @map("escalation_due_at")
  escalationLevel      Int            @default(0) @map("escalation_level")
  /// Set the moment a person assigns by hand. The router treats it as a stop sign.
  manualOverrideById   String?        @map("manual_override_by_id") @db.Uuid
  manualOverrideAt     DateTime?      @map("manual_override_at")
  manualOverrideReason String?        @map("manual_override_reason")
  queueReason          String?        @map("queue_reason")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  ticket           Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization     Organization @relation(fields: [organizationId], references: [id])
  acknowledgedBy   User?        @relation("RoutingAcknowledgedBy", fields: [acknowledgedById], references: [id])
  manualOverrideBy User?        @relation("RoutingOverriddenBy", fields: [manualOverrideById], references: [id])

  @@index([organizationId, acknowledgeDueAt])
  @@index([organizationId, escalationDueAt])
  @@map("ticket_routing_state")
}

/// Every candidate the router considered, and why it did or did not choose them.
///
/// Append-only. A reassignment adds rows; it never rewrites the ones explaining the decision it
/// replaced, because the question a trail answers is "why did this happen", and that question is
/// asked about the past.
model TicketRoutingTrail {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  ticketId        String             @map("ticket_id") @db.Uuid
  attempt         Int
  position        Int
  candidateUserId String?            @map("candidate_user_id") @db.Uuid
  role            RoutingRole
  accepted        Boolean            @default(false)
  skipReason      RoutingSkipReason? @map("skip_reason")
  detail          String
  policyVersion   Int                @default(1) @map("policy_version")
  createdAt       DateTime           @default(now()) @map("created_at")

  organization  Organization @relation(fields: [organizationId], references: [id])
  ticket        Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  candidateUser User?        @relation("RoutingCandidate", fields: [candidateUserId], references: [id])

  @@index([ticketId, attempt, position])
  @@index([organizationId, createdAt])
  @@map("ticket_routing_trail")
}

// ---------------------------------------------------------------------------------------------
// Product registry and external support ingress (package 8c)
// ---------------------------------------------------------------------------------------------

enum SupportTier {
  BASIC
  STANDARD
  PRIORITY
  ENTERPRISE
}

/// A product or application allowed to raise support tickets without a human Desk login.
///
/// Points at a project rather than restating it: the team, the ownership chain and the rotas all
/// live there, and a second copy would give the router two places to look. What lives here is
/// only what the *ingress* needs to decide — whether support is open, which sources and work
/// areas are allowed, and what a ticket should default to.
model Product {
  id                 String         @id @default(uuid(7)) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  /// Short stable key, e.g. CARELIX. Unique inside the organization.
  code               String
  name               String
  description        String?
  isActive           Boolean        @default(true) @map("is_active")
  /// The project whose team owns this product's support. Ingress refuses without one.
  projectId          String?        @map("project_id") @db.Uuid
  supportEnabled     Boolean        @default(true) @map("support_enabled")
  /// Whether tickets from this product go through the package 8b router at all.
  autoRouteEnabled   Boolean        @default(true) @map("auto_route_enabled")
  /// Configuration only in 8c. Package 9 reads it to decide whether to offer a call.
  ivrEnabled         Boolean        @default(false) @map("ivr_enabled")
  supportTier        SupportTier    @default(STANDARD) @map("support_tier")
  /// Sources this product may declare. Empty means any source is acceptable.
  allowedSources     TicketSource[] @map("allowed_sources")
  /// Work areas its tickets may name. Empty means any.
  allowedWorkAreas   String[]       @map("allowed_work_areas")
  /// Browser origins the embedded support widget may run on, exactly as a browser spells them
  /// (`https://app.example.com`). A list of literals, never a pattern: a wildcard here is a
  /// wildcard in `Access-Control-Allow-Origin`, and the widget token is origin-bound against
  /// these. Empty means no widget — the product is server-to-server only.
  allowedOrigins     String[]       @map("allowed_origins")
  defaultPriority    Priority       @default(MEDIUM) @map("default_priority")
  defaultType        TicketType     @default(SUPPORT) @map("default_type")
  /// The Desk identity that stands as requester on tickets this product raises. See the API type
  /// for why an external reporter cannot simply be the requester.
  supportRequesterId String?        @map("support_requester_id") @db.Uuid
  createdById        String         @map("created_by_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  organization     Organization @relation(fields: [organizationId], references: [id])
  project          Project?     @relation(fields: [projectId], references: [id])
  supportRequester User?        @relation("ProductSupportRequester", fields: [supportRequesterId], references: [id])
  createdBy        User         @relation("ProductCreator", fields: [createdById], references: [id])

  credentials        ProductCredential[]
  externalRequesters ExternalRequester[]
  tickets            Ticket[]
  ingressRequests    SupportIngressRequest[]
  /// Everything about calls that `ivrEnabled` does not say. Absent until somebody configures it.
  ivrPolicy          ProductIvrPolicy?
  calls              CallLog[]
  /// Where status changes are pushed back to. Absent until somebody configures it.
  callbackEndpoint   ProductCallbackEndpoint?
  callbackDeliveries SupportCallbackDelivery[]
  problems           Problem[]
  incidents          Incident[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("products")
}

/// A machine credential: what a product presents instead of a human login.
///
/// Only the hash is stored, and it is a hash rather than ciphertext on purpose — nothing in the
/// product ever needs to read a secret back, so nothing should be able to. The key id is public
/// and identifies which hash to verify against, which keeps the check a single lookup instead of
/// a scan across every credential (slow, and a timing oracle).
model ProductCredential {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  /// Public half. Safe to display, safe to log, safe to put in an audit row.
  keyId          String    @unique @map("key_id")
  /// Argon2id of the secret half. Never selected into any DTO.
  secretHash     String    @map("secret_hash")
  label          String
  isActive       Boolean   @default(true) @map("is_active")
  lastUsedAt     DateTime? @map("last_used_at")
  rotatedAt      DateTime? @map("rotated_at")
  revokedAt      DateTime? @map("revoked_at")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProductCredentialCreator", fields: [createdById], references: [id])

  @@index([productId, isActive])
  @@map("product_credentials")
}

/// Somebody who reported a problem through a product and has no Desk account.
///
/// Enough identity to answer them and to recognise them next time, and no more. Deliberately not
/// a `User`: creating a Desk account for every person who ever hits a support button would fill
/// the directory with accounts nobody can sign into and that every permission check has to skip.
model ExternalRequester {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  /// The product's own identifier for this person. Opaque to Desk.
  externalId     String   @map("external_id")
  name           String?
  email          String?
  phone          String?
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  calls        CallLog[]

  @@unique([productId, externalId])
  @@map("external_requesters")
}

/// One accepted ingress request, keyed by the caller's idempotency key.
///
/// The unique constraint is the whole mechanism: the row and the ticket are created in one
/// transaction, so a concurrent duplicate loses the insert, rolls back, re-reads the committed
/// row and returns the same ticket. No locks, no polling, and no window in which two tickets
/// exist for one request.
model SupportIngressRequest {
  id                String   @id @default(uuid(7)) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  /// Scoped to the product, because two products may sensibly use the same key.
  idempotencyKey    String   @map("idempotency_key")
  ticketId          String   @map("ticket_id") @db.Uuid
  /// Which credential was presented. The id, never the secret.
  credentialKeyId   String?  @map("credential_key_id")
  externalReference String?  @map("external_reference")
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([productId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("support_ingress_requests")
}

// ---------------------------------------------------------------------------------------------
// Outbound status callbacks
//
// The ingress is one-way: a product raises a ticket and then has to poll to learn anything. These
// two tables are the other direction — Desk telling the product what happened, once, with a
// signature the product can check.
//
// Everything sent is built from the same allow-list the ingress status endpoint uses. There is no
// column here for an assignee, an internal note or a routing decision, and that is the protection:
// a payload cannot leak what the shape has no room for.
// ---------------------------------------------------------------------------------------------

/// Mirrors OutboundMessageStatus, and for the same reasons. See that enum.
enum SupportCallbackStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  /// Deliberately not sent: the endpoint is off, or does not subscribe to this event.
  SKIPPED
}

/// Where one product's status callbacks are sent, and what signs them.
///
/// Optional, like `ProductIvrPolicy`: a product without a row simply gets no callbacks. The
/// signing secret is **encrypted, not hashed** — the opposite of a machine credential — because
/// Desk has to read it back on every delivery in order to sign with it. A hash could only ever
/// verify something somebody else computed, which is not the direction this runs in.
model ProductCallbackEndpoint {
  id                     String    @id @default(uuid(7)) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  productId              String    @unique @map("product_id") @db.Uuid
  /// HTTPS only, and checked against the address it resolves to before it is ever saved.
  url                    String
  /// AES-256-GCM ciphertext from SecretCipherService. Never returned by any endpoint.
  signingSecretEncrypted String    @map("signing_secret_encrypted")
  /// Which events to send. Empty means every event, following ProductIvrPolicy.allowedTiers.
  events                 String[]
  enabled                Boolean   @default(true)
  /// When the secret was last replaced, so an administrator can see that a rotation happened.
  rotatedAt              DateTime? @map("rotated_at")
  updatedById            String?   @map("updated_by_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("CallbackEndpointEditor", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@map("product_callback_endpoints")
}

/// One attempt to tell a product something. Modelled on OutboundMessage field for field.
model SupportCallbackDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  ticketId       String?               @map("ticket_id") @db.Uuid
  /// The event key from packages/types. A string rather than an enum: the set grows often.
  event          String
  status         SupportCallbackStatus @default(QUEUED)
  /**
   * Identifies the business event. The unique index below is what stops the same transition
   * being delivered twice when a job is retried or an emission runs again.
   */
  idempotencyKey String                @map("idempotency_key")
  /// Where it was sent, as it was at the time, so history stays readable after a change.
  url            String
  attempts       Int                   @default(0)
  /// Already redacted before it is written; safe to show an administrator.
  lastError      String?               @map("last_error")
  /// The last HTTP status the endpoint answered with, for a person diagnosing a receiver.
  responseStatus Int?                  @map("response_status")
  /// The exact body that was signed and sent, so a redelivery replays it rather than rebuilding
  /// it from a ticket that has since moved on.
  payload        Json
  queuedAt       DateTime              @default(now()) @map("queued_at")
  sentAt         DateTime?             @map("sent_at")
  failedAt       DateTime?             @map("failed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, productId, queuedAt])
  /// The stalled-claim sweep runs across every tenant, so it has no organization to lead with
  /// and the index above cannot serve it.
  @@index([status, updatedAt])
  @@map("support_callback_deliveries")
}

// ---------------------------------------------------------------------------------------------
// Support tier behaviour
//
// `supportTier` has been recorded on every product since package 8c and read exactly once — by
// the IVR policy, to decide whether a tier may raise a call. These rows are what turn it into
// behaviour, and they are configuration rather than code: what a tier is worth is a commercial
// decision, and hard-coding one would make every customer's pricing a deployment.
// ---------------------------------------------------------------------------------------------

/// Where a ticket goes when the routing chain and escalation both come up empty.
enum SupportFallbackStrategy {
  /// Leave it in the support queue with a reason on it. What every tier does today.
  SUPPORT_QUEUE
  /// Also notify the support executive immediately rather than on the escalation timer.
  NOTIFY_EXECUTIVE
}

/// When a tier's entitlements apply.
enum SupportAvailabilityWindow {
  /// The SLA policy's business hours, which is what an unconfigured tier already gets.
  BUSINESS_HOURS
  /// Every hour of every day.
  ALWAYS
}

/// What one support tier entitles a product to, inside one organization.
///
/// Absence is the neutral answer, everywhere: no row for a tier means that tier behaves exactly as
/// it did before this table existed, and a null column means that one aspect is left alone. This
/// is the same convention as `ProductIvrPolicy.allowedTiers`, where empty means every tier — an
/// unconfigured policy must never be read as a restrictive one.
///
/// Deliberately not priced. There is no amount, no currency and no billing link here: this says
/// what a tier *does*, and what it costs is somebody else's decision recorded somewhere else.
model SupportTierPolicy {
  id                      String                    @id @default(uuid(7)) @db.Uuid
  organizationId          String                    @map("organization_id") @db.Uuid
  tier                    SupportTier
  /// Whether this tier may raise tickets at all. False closes the ingress for it.
  admissionEnabled        Boolean                   @default(true) @map("admission_enabled")
  /// The SLA policy this tier selects, sitting between a project's policy and the client's.
  slaPolicyId             String?                   @map("sla_policy_id") @db.Uuid
  /// The lowest priority a ticket from this tier is filed at. Null leaves the product's default.
  minimumPriority         Priority?                 @map("minimum_priority")
  /// Whether calls are offered at all, and whether the requester may start one.
  callsEnabled            Boolean                   @default(true) @map("calls_enabled")
  requesterInitiatedCalls Boolean                   @default(true) @map("requester_initiated_calls")
  /// Whether this tier gets a named owner rather than whoever the chain reaches.
  dedicatedOwnership      Boolean                   @default(false) @map("dedicated_ownership")
  /// Minutes to acknowledge, and minutes after that to escalate. Null keeps the project's own.
  ackMinutes              Int?                      @map("ack_minutes")
  escalationMinutes       Int?                      @map("escalation_minutes")
  fallbackStrategy        SupportFallbackStrategy   @default(SUPPORT_QUEUE) @map("fallback_strategy")
  availabilityWindow      SupportAvailabilityWindow @default(BUSINESS_HOURS) @map("availability_window")
  updatedById             String?                   @map("updated_by_id") @db.Uuid
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  slaPolicy    SlaPolicy?   @relation("SupportTierPolicySla", fields: [slaPolicyId], references: [id])
  updatedBy    User?        @relation("SupportTierPolicyEditor", fields: [updatedById], references: [id])

  @@unique([organizationId, tier])
  @@index([organizationId])
  @@map("support_tier_policies")
}

// ---------------------------------------------------------------------------------------------
// IVR support calls (Phase 4, package 9)
// ---------------------------------------------------------------------------------------------
//
// Desk does not place calls; Ashniva IVR does. What lives here is the decision and the record —
// whether a call may happen, who it should reach, what was tried, how it ended, and where the
// recording is. No audio is stored: `recording_ref` names what the provider holds.

/// Where a call is in its life. Mirrors CALL_STATUS in packages/types.
enum CallStatus {
  REQUESTED
  RINGING
  CONNECTED
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
}

/// Whether the provider is asked to record, and on what basis.
enum RecordingPolicy {
  DISABLED
  ON_CONSENT
  ALWAYS
}

/// How far playback reaches, on top of the `call:play-recording` permission. Each widens the
/// previous. No value admits a client — that is refused before the scope is consulted.
enum RecordingPlaybackScope {
  LEADS_ONLY
  CONNECTED_STAFF
  PROJECT_STAFF
}

/// Which rung of the ladder a call destination came from.
enum CallRoutingStep {
  ASSIGNED_OWNER
  ROUTING_CHAIN
  ESCALATION
  POLICY_FALLBACK
  SUPPORT_QUEUE
}

/// What a product allows its support calls to do.
///
/// The switch itself stays on `Product.ivrEnabled`, where package 8c put it. This row is
/// everything else, and it is optional: a product with no policy row uses the defaults below,
/// which record nothing and let nobody but staff start a call.
model ProductIvrPolicy {
  id                       String                 @id @default(uuid(7)) @db.Uuid
  organizationId           String                 @map("organization_id") @db.Uuid
  productId                String                 @unique @map("product_id") @db.Uuid
  recordingPolicy          RecordingPolicy        @default(DISABLED) @map("recording_policy")
  recordingPlaybackScope   RecordingPlaybackScope @default(LEADS_ONLY) @map("recording_playback_scope")
  /// Support tiers whose tickets may raise a call. Empty means every tier.
  allowedTiers             SupportTier[]          @map("allowed_tiers")
  /// Whether the person who raised the ticket may ask for a call, or only staff may place one.
  requesterInitiateEnabled Boolean                @default(false) @map("requester_initiate_enabled")
  /// Where a call goes when the routing chain and escalation both come up empty.
  fallbackUserId           String?                @map("fallback_user_id") @db.Uuid
  /// The most destinations one call may try before it stops and tells a person.
  maxAttempts              Int                    @default(3) @map("max_attempts")
  updatedById              String?                @map("updated_by_id") @db.Uuid
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  fallbackUser User?        @relation("IvrPolicyFallback", fields: [fallbackUserId], references: [id])
  updatedBy    User?        @relation("IvrPolicyEditor", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@map("product_ivr_policies")
}

/// One support call, attached to the ticket it was about.
model CallLog {
  id                  String     @id @default(uuid(7)) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  /// Why this call exists. A support call walks package 8b's chain because a client's problem
  /// belongs to whoever can take it; an internal call does not, because quietly connecting a
  /// private conversation to an unrelated colleague would be a disclosure, not a fallback.
  kind                CallKind   @default(SUPPORT)
  /// Set for a support call. Null for an internal call, which belongs to a conversation instead.
  ticketId            String?    @map("ticket_id") @db.Uuid
  /// Set when the call was placed from an internal conversation.
  conversationId      String?    @map("conversation_id") @db.Uuid
  taskId              String?    @map("task_id") @db.Uuid
  productId           String?    @map("product_id") @db.Uuid
  projectId           String?    @map("project_id") @db.Uuid
  /// Which adapter placed it, so a history spanning a provider change stays readable.
  providerKey         String     @map("provider_key")
  /// The provider's own id. This is the *only* key an inbound webhook is trusted to carry: the
  /// organization, product and ticket are read from this row, never from the callback payload.
  providerCallId      String?    @map("provider_call_id")
  status              CallStatus @default(REQUESTED)
  /// The provider's own word for how the call ended, unmapped. Kept beside the mapped status
  /// because the person reading the history may know what their provider meant.
  providerDisposition String?    @map("provider_disposition")
  initiatedById       String?    @map("initiated_by_id") @db.Uuid
  requesterId         String?    @map("requester_id") @db.Uuid
  externalRequesterId String?    @map("external_requester_id") @db.Uuid
  connectedUserId     String?    @map("connected_user_id") @db.Uuid
  /// A masked reference, never a dialable number. The IVR bridges the two legs; Desk never
  /// learns either party's number and so can never leak one.
  clientPhoneRef      String?    @map("client_phone_ref")
  recordingConsent    Boolean    @default(false) @map("recording_consent")
  /// What the provider holds. Not audio, and not a URL — playback mints a short-lived one.
  recordingRef        String?    @map("recording_ref")
  recordingReadyAt    DateTime?  @map("recording_ready_at")
  attemptCount        Int        @default(0) @map("attempt_count")
  maxAttempts         Int        @default(3) @map("max_attempts")
  /// Why the call ended without reaching anybody. A call is never dropped silently.
  queueReason         String?    @map("queue_reason")
  lastError           String?    @map("last_error")
  requestedAt         DateTime   @default(now()) @map("requested_at")
  ringingAt           DateTime?  @map("ringing_at")
  connectedAt         DateTime?  @map("connected_at")
  endedAt             DateTime?  @map("ended_at")
  durationSeconds     Int?       @map("duration_seconds")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  ticket            Ticket?            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id])
  task              Task?              @relation(fields: [taskId], references: [id])
  product           Product?           @relation(fields: [productId], references: [id])
  project           Project?           @relation(fields: [projectId], references: [id])
  initiatedBy       User?              @relation("CallInitiator", fields: [initiatedById], references: [id])
  requester         User?              @relation("CallRequester", fields: [requesterId], references: [id])
  externalRequester ExternalRequester? @relation(fields: [externalRequesterId], references: [id])
  connectedUser     User?              @relation("CallConnectedStaff", fields: [connectedUserId], references: [id])
  attempts          CallAttempt[]
  participants      CallParticipant[]

  /// Provider call ids are unique within a provider, which is what makes the webhook correlation
  /// trustworthy. Nullable until the provider answers, and Postgres treats NULLs as distinct.
  @@unique([providerKey, providerCallId])
  @@index([organizationId, requestedAt])
  @@index([ticketId, requestedAt])
  @@index([conversationId, requestedAt])
  @@map("call_logs")
}

/// One attempt to reach one destination. A call that rang three people has three of these.
///
/// Kept even when it failed, and especially then: "we tried the on-call developer, then the
/// senior, and neither answered" is the fact somebody needs when a client says nobody called
/// back. The sequence is unique per call, which is also how a concurrent worker claims the next
/// attempt without two of them ringing two people at once.
model CallAttempt {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  callId         String          @map("call_id") @db.Uuid
  sequence       Int
  step           CallRoutingStep
  /// The chain position the routing engine named, when it named one.
  routingRole    String?         @map("routing_role")
  targetUserId   String?         @map("target_user_id") @db.Uuid
  status         CallStatus      @default(REQUESTED)
  /// Why this destination was chosen, or why the call stopped here.
  reason         String
  providerCallId String?         @map("provider_call_id")
  startedAt      DateTime        @default(now()) @map("started_at")
  endedAt        DateTime?       @map("ended_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  call         CallLog      @relation(fields: [callId], references: [id], onDelete: Cascade)
  target       User?        @relation("CallAttemptTarget", fields: [targetUserId], references: [id])

  @@unique([callId, sequence])
  @@index([organizationId, startedAt])
  /// How a provider event for a superseded leg still finds the call it belongs to. The call row
  /// carries only the latest leg's id; an event for an earlier one would otherwise look unknown,
  /// and an unknown delivery is one the provider keeps retrying.
  @@index([providerCallId])
  @@map("call_attempts")
}

// ---------------------------------------------------------------------------------------------
// Internal project communication (Phase 4, package 9b)
// ---------------------------------------------------------------------------------------------
//
// Not a company messenger. Every conversation names a project, because the right to talk to
// somebody is derived from a shared project rather than from being an employee — and a
// conversation with no project has no relationship to derive permission from.
//
// The tables below store who a conversation is *for*. Whether you may act on it today is answered
// by `CommunicationPolicyService` on every request, from live project membership. A participant
// row is a read cursor and a hint; it is never an authorization record, which is why removing
// somebody from a project removes their access without any row being deleted.

/// What a conversation is attached to.
enum ConversationKind {
  PROJECT
  TASK
  TICKET
  DIRECT
  /// A direct message admitted by management scope rather than by a shared project. No project.
  SCOPE_DIRECT
  /// A named group whose member rows are its membership. No project.
  GROUP
}

/// Somebody's standing on a conversation's member list. Only meaningful for a GROUP.
enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// A message the system wrote rather than a person.
enum MessageSystemKind {
  CALL_STARTED
  CALL_ENDED
  CONVERSATION_CREATED
}

/// Why a call exists, and therefore which destination policy applies to it.
enum CallKind {
  SUPPORT
  INTERNAL
}

/// What happens to an internal call whose intended participant cannot be reached.
enum InternalCallFallback {
  NONE
  PROJECT_LEAD
}

/// One organization's internal chat and calling switches.
///
/// Chat and calling are separate flags because an organization may sensibly want one without the
/// other. Calling is off by default: telephony costs money and reaches people's phones, and
/// neither should start happening because a table was created.
model CommunicationSettings {
  id                     String                 @id @default(uuid(7)) @db.Uuid
  organizationId         String                 @unique @map("organization_id") @db.Uuid
  chatEnabled            Boolean                @default(true) @map("chat_enabled")
  callingEnabled         Boolean                @default(false) @map("calling_enabled")
  recordingPolicy        RecordingPolicy        @default(DISABLED) @map("recording_policy")
  recordingPlaybackScope RecordingPlaybackScope @default(LEADS_ONLY) @map("recording_playback_scope")
  /// The documented internal-call fallback. `NONE` by default: a private call reaches the person
  /// it was for, or nobody. It is never re-routed to a support agent.
  internalCallFallback   InternalCallFallback   @default(NONE) @map("internal_call_fallback")
  updatedById            String?                @map("updated_by_id") @db.Uuid
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  updatedBy    User?        @relation("CommunicationSettingsEditor", fields: [updatedById], references: [id])

  @@map("communication_settings")
}

/// One internal conversation.
///
/// Attached to a project for the four kinds whose permission is derived from one. The two scope
/// kinds — SCOPE_DIRECT and GROUP — have no project, because their permission is derived from
/// management scope instead, and a project column filled in with something plausible would be a
/// lie the policy would then be tempted to read.
model Conversation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  /// The project this conversation hangs off, and NULL for the two scope kinds. A task or ticket
  /// conversation resolves its project from the task or ticket, and moving that work moves the
  /// conversation's authority. The foreign key still cascades: deleting a project takes its
  /// conversations with it, and leaves the project-less ones alone.
  projectId      String?          @map("project_id") @db.Uuid
  kind           ConversationKind
  taskId         String?          @map("task_id") @db.Uuid
  ticketId       String?          @map("ticket_id") @db.Uuid
  title          String?
  /// The two people sorted, so one pair can only ever have one row: per project for DIRECT, and
  /// for the whole organization for SCOPE_DIRECT — which is why the scope key is computed from
  /// the two user ids alone.
  directKey      String?          @map("direct_key")
  /// A group's picture. An ordinary `files` row, under the same tenancy and storage as every
  /// other file in the product.
  imageFileId    String?          @map("image_file_id") @db.Uuid
  /// The anchor, flattened into one non-null string — `PROJECT:<id>`, `TASK:<id>`, `TICKET:<id>`,
  /// `DIRECT:<projectId>:<pair>`, `SCOPE_DIRECT:<pair>` or `GROUP:<random>`. It exists because a
  /// unique index over the nullable columns would not have enforced anything: Postgres treats
  /// nulls as distinct, so every kind (each of which leaves at least one of them null) would have
  /// been exempt from the very constraint meant to hold it to one thread. Two people opening the
  /// same task at the same moment proved it — and `project_id` becoming nullable is the same trap
  /// a second time, which is why the unique index moved to `(organization_id, anchor_key)` and
  /// the project's id moved *into* the key for the kinds that have one.
  anchorKey      String           @map("anchor_key")
  createdById    String           @map("created_by_id") @db.Uuid
  lastMessageAt  DateTime?        @map("last_message_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  image        File?        @relation("ConversationImage", fields: [imageFileId], references: [id])
  createdBy    User         @relation("ConversationCreator", fields: [createdById], references: [id])

  members  ConversationMember[]
  messages Message[]
  calls    CallLog[]

  /// One project channel per project, one thread per task, one per ticket, one per pair, one row
  /// per group — over two non-null columns in one tenant, so the database is what enforces it and
  /// the loser of a race re-reads.
  @@unique([organizationId, anchorKey])
  @@index([organizationId, lastMessageAt])
  @@index([projectId, kind])
  @@map("conversations")
}

/// Somebody's place in a conversation.
///
/// **For a project-anchored conversation this is not an authorization record.** It carries the
/// read cursor that makes unread counts cheap and, for a DIRECT conversation, the two people the
/// conversation is between. Access is recomputed from project membership on every request; a row
/// here grants nothing on its own, which is exactly why a developer removed from a project loses
/// access without a row changing.
///
/// **For a GROUP it is.** A group has no project to derive membership from, so the list is the
/// membership — a real change of contract, and the reason the rest of this model exists. What
/// keeps a list from outliving the relationship that justified it is that every addition is
/// re-checked against the adder's management scope at the moment it is made, and that leaving is
/// expressible: `leftAt` is set rather than the row being deleted, so the thread still renders
/// who said what and a former member reads nothing.
model ConversationMember {
  conversationId String                 @map("conversation_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  /// Standing on the list. MEMBER everywhere except a group, whose maker is its OWNER.
  role           ConversationMemberRole @default(MEMBER)
  lastReadAt     DateTime?              @map("last_read_at")
  /// When they joined. Distinct from `created_at`, which never moves: somebody who left a group
  /// and was added back rejoins, and the row they rejoin is the one that already exists.
  joinedAt       DateTime               @default(now()) @map("joined_at")
  /// When they left or were removed. NULL means they are in the conversation now.
  leftAt         DateTime?              @map("left_at")
  /// Who put them here. NULL when they added themselves — opening a thread, or making a group.
  addedById      String?                @map("added_by_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  addedBy      User?        @relation("ConversationMemberAdder", fields: [addedById], references: [id])

  @@id([conversationId, userId])
  /// Member-first, and covering: "the conversations this person is in" is the predicate behind
  /// every list and every membership check, and the primary key is conversation-first, so it
  /// cannot serve one. The conversation id is carried so the lookup never touches the heap.
  @@index([userId, conversationId])
  @@map("conversation_members")
}

/// One message.
model Message {
  id              String             @id @default(uuid(7)) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  conversationId  String             @map("conversation_id") @db.Uuid
  /// The conversation's project, copied so a message can be found by project without a join.
  /// NULL for a message in a scope conversation, which has no project — the same nullability, for
  /// the same reason, as the column it copies.
  projectId       String?            @map("project_id") @db.Uuid
  /// Null for a system message — a call starting or ending is written by nobody.
  senderId        String?            @map("sender_id") @db.Uuid
  body            String
  systemKind      MessageSystemKind? @map("system_kind")
  /// The sender's own id for this send, so a retried request returns the first message rather
  /// than posting a second one. Unique per conversation.
  clientMessageId String?            @map("client_message_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  editedAt        DateTime?          @map("edited_at")
  deletedAt       DateTime?          @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender       User?             @relation("MessageSender", fields: [senderId], references: [id])
  attachments  File[]
  revisions    MessageRevision[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  /// The actual pagination predicate. A page of a thread is `conversation_id = $1 AND id < $2
  /// ORDER BY id DESC`, and until this index existed there was nothing supporting it: the
  /// `created_at` index above answers the unread-count group-by, not the cursor walk, so paging
  /// backwards through a long thread sorted the conversation each time.
  @@index([conversationId, id(sort: Desc)])
  @@index([organizationId, createdAt])
  @@map("messages")
}

/// What a message said before somebody edited it.
///
/// An edit is allowed for a short window (`MESSAGE_EDIT_WINDOW_MINUTES`) so a typo can be fixed
/// without deleting and reposting. That window is short, but it is not zero, and inside it a
/// colleague may already have read and acted on the words being replaced — so the previous body is
/// kept rather than overwritten. Nobody reads these in the ordinary thread; they exist so that
/// oversight can answer "what did this actually say", which a destructive edit makes unanswerable.
///
/// Deliberately *not* the audit log: a message body has no business in an audit payload (see
/// `MessagesService`), and a revision belongs with the message, under the same tenancy, the same
/// row-level policy and the same retention as the row it supersedes.
model MessageRevision {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  /// The body as it stood before the edit this row records.
  body           String
  /// Who made the edit. Only ever the sender — nobody rewrites another person's words.
  editedById     String?  @map("edited_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editedBy     User?        @relation("MessageRevisionEditor", fields: [editedById], references: [id])

  @@index([messageId, createdAt])
  @@map("message_revisions")
}

/// Who was on a call.
///
/// Separate from `call_attempts`, which records who a *support* call rang and why. This records
/// who an internal call was between, which is part of what the call was rather than a record of
/// how it was routed.
model CallParticipant {
  id             String    @id @default(uuid(7)) @db.Uuid
  callId         String    @map("call_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// Whether they started the call or were rung.
  isInitiator    Boolean   @default(false) @map("is_initiator")
  joinedAt       DateTime? @map("joined_at")
  leftAt         DateTime? @map("left_at")

  call         CallLog      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user         User         @relation("CallParticipantUser", fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([callId, userId])
  @@index([userId])
  @@map("call_participants")
}

// ---------------------------------------------------------------------------------------------
// Package 11 — recurring issues, problems, root-cause analysis and incidents
//
// Four records and one index. A *similarity match* is a suggestion nobody has acted on; a
// *problem* is the same fault reported by several clients; an *RCA* is the write-up that explains
// it; an *incident* is something broken right now. They are separate tables because they are
// answered by different people on different clocks, and because collapsing any two of them would
// mean one of the two could never be closed on its own terms.
//
// All of it is provider-only. §19.2 of the Architecture Plan is explicit that a client — admin or
// employee — may *never* see another client's ticket through a problem, so none of these tables
// has a client branch in its policy and none of them has a portal mapper.
// ---------------------------------------------------------------------------------------------

enum ProblemStatus {
  OPEN
  RCA_REQUESTED
  RCA_SUBMITTED
  FIX_ASSIGNED
  FIX_RELEASED
  CLOSED
}

enum ProblemTicketRelation {
  DUPLICATE
  RELATED
}

enum SimilarityDecision {
  PENDING
  LINKED
  DISMISSED
}

enum RcaStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum RcaActionKind {
  CORRECTIVE
  PREVENTIVE
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  CLOSED
}

enum EmergencyFixStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

enum IncidentTimelineKind {
  OPENED
  STATUS_CHANGED
  SEVERITY_CHANGED
  OWNER_CHANGED
  NOTE
  LINK_ADDED
  EMERGENCY_FIX_REQUESTED
  EMERGENCY_FIX_APPROVED
  EMERGENCY_FIX_REJECTED
  CLIENT_SUMMARY_PUBLISHED
  RESOLVED
  CLOSED
}

enum IncidentLinkKind {
  TICKET
  TASK
  RELEASE
}

/// One suggested duplicate, and what a person decided about it.
///
/// Stored rather than recomputed so a dismissal sticks: without a row, the same pair would be
/// suggested again on the next page load, and a suggestion people have learned to ignore is worse
/// than no suggestion at all.
model SimilarityMatch {
  id                String             @id @default(uuid(7)) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  ticketId          String             @map("ticket_id") @db.Uuid
  candidateTicketId String             @map("candidate_ticket_id") @db.Uuid
  /// The rank the matcher gave this pair. Shown as its reasons, never as a percentage.
  score             Decimal            @db.Decimal(6, 2)
  /// Plain phrases ready to show: "module Auth", "keywords: slow, mornings".
  signals           String[]
  decision          SimilarityDecision @default(PENDING)
  decidedById       String?            @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?          @map("decided_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id])
  ticket          Ticket       @relation("SimilaritySubject", fields: [ticketId], references: [id], onDelete: Cascade)
  candidateTicket Ticket       @relation("SimilarityCandidate", fields: [candidateTicketId], references: [id], onDelete: Cascade)
  decidedBy       User?        @relation("SimilarityDecider", fields: [decidedById], references: [id])

  /// One row per ordered pair. The service writes the pair in both directions when a decision is
  /// taken, so dismissing from either ticket dismisses it from the other.
  @@unique([ticketId, candidateTicketId])
  @@index([organizationId, decision])
  @@map("similarity_matches")
}

/// The same fault, reported more than once.
model Problem {
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  /// Sequential per organization; displayed as "PRB-<number>".
  number               Int
  title                String
  description          String?
  status               ProblemStatus @default(OPEN)
  /// Reuses `Priority` rather than a second four-level scale — the approved design shows the same
  /// Critical/High pill on a problem as on everything else.
  severity             Priority      @default(HIGH)
  projectId            String?       @map("project_id") @db.Uuid
  productId            String?       @map("product_id") @db.Uuid
  module               String?
  /// Every version the linked tickets reported, so "3 clients on 3.1.4" can be said accurately.
  versions             String[]
  ownerId              String?       @map("owner_id") @db.Uuid
  /// When the duplicate threshold was crossed. Null on a problem somebody opened by hand.
  thresholdHitAt       DateTime?     @map("threshold_hit_at")
  /// When the RCA is due, set by whoever requested it.
  rcaDueDate           DateTime?     @map("rca_due_date") @db.Date
  /// The task doing the permanent fix. A link, never a second copy of the work.
  fixTaskId            String?       @map("fix_task_id") @db.Uuid
  /// The task adding the test that stops it coming back.
  preventiveTestTaskId String?       @map("preventive_test_task_id") @db.Uuid
  /// What the preventive test actually is, in words, for the case where no task was needed.
  preventiveTest       String?       @map("preventive_test")
  closedAt             DateTime?     @map("closed_at")
  closedById           String?       @map("closed_by_id") @db.Uuid
  createdById          String        @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])
  project            Project?     @relation(fields: [projectId], references: [id])
  product            Product?     @relation(fields: [productId], references: [id])
  owner              User?        @relation("ProblemOwner", fields: [ownerId], references: [id])
  createdBy          User         @relation("ProblemCreator", fields: [createdById], references: [id])
  fixTask            Task?        @relation("ProblemFixTask", fields: [fixTaskId], references: [id])
  preventiveTestTask Task?        @relation("ProblemPreventiveTestTask", fields: [preventiveTestTaskId], references: [id])

  tickets       ProblemTicket[]
  primaryTicket Ticket[]          @relation("ProblemPrimaryTickets")
  questions     ProblemQuestion[]
  rca           RcaReport?
  incidents     Incident[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([ownerId])
  /// The problem list's ordering.
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "problems_org_created_idx")
  @@map("problems")
}

/// A ticket's membership of a problem, and how strong the claim is.
model ProblemTicket {
  problemId      String                @map("problem_id") @db.Uuid
  ticketId       String                @map("ticket_id") @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  relation       ProblemTicketRelation @default(DUPLICATE)
  linkedById     String?               @map("linked_by_id") @db.Uuid
  linkedAt       DateTime              @default(now()) @map("linked_at")

  problem      Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  linkedBy     User?        @relation("ProblemTicketLinker", fields: [linkedById], references: [id])

  @@id([problemId, ticketId])
  @@index([ticketId])
  @@map("problem_tickets")
}

/// A question somebody put to the problem's owner, and the answer if one came.
model ProblemQuestion {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  problemId      String    @map("problem_id") @db.Uuid
  body           String
  askedById      String    @map("asked_by_id") @db.Uuid
  askedAt        DateTime  @default(now()) @map("asked_at")
  answer         String?
  answeredById   String?   @map("answered_by_id") @db.Uuid
  answeredAt     DateTime? @map("answered_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  problem      Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  askedBy      User         @relation("ProblemQuestionAsker", fields: [askedById], references: [id])
  answeredBy   User?        @relation("ProblemQuestionAnswerer", fields: [answeredById], references: [id])

  @@index([problemId, askedAt])
  @@map("problem_questions")
}

/// The root-cause analysis: the approved form's ten questions, one row per problem.
model RcaReport {
  id                      String    @id @default(uuid(7)) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  problemId               String    @unique @map("problem_id") @db.Uuid
  status                  RcaStatus @default(DRAFT)
  /// 1. What happened?
  what                    String    @default("")
  /// 2. Why did it happen?
  why                     String    @default("")
  /// 3. Clients and versions affected.
  affectedClientsVersions String    @default("") @map("affected_clients_versions")
  /// 4. Introduced by — a release, a pull request or a change, in words.
  introducedBy            String    @default("") @map("introduced_by")
  /// The release this analysis blames, when one was named. The words above stay either way.
  introducedByReleaseId   String?   @map("introduced_by_release_id") @db.Uuid
  /// 5. Workaround offered while the fix was made.
  workaround              String    @default("")
  /// 6. Permanent solution.
  permanentFix            String    @default("") @map("permanent_fix")
  /// 7. Prevention.
  prevention              String    @default("")
  /// 8. Tests added.
  testsAdded              String    @default("") @map("tests_added")
  /// 9. Owner.
  ownerId                 String?   @map("owner_id") @db.Uuid
  /// 10. Target date.
  targetDate              DateTime? @map("target_date") @db.Date
  submittedById           String?   @map("submitted_by_id") @db.Uuid
  submittedAt             DateTime? @map("submitted_at")
  approvedById            String?   @map("approved_by_id") @db.Uuid
  approvedAt              DateTime? @map("approved_at")
  /// Why it was sent back, when it was.
  reviewNote              String?   @map("review_note")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  organization        Organization @relation(fields: [organizationId], references: [id])
  problem             Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  introducedByRelease Release?     @relation(fields: [introducedByReleaseId], references: [id])
  owner               User?        @relation("RcaOwner", fields: [ownerId], references: [id])
  submittedBy         User?        @relation("RcaSubmitter", fields: [submittedById], references: [id])
  approvedBy          User?        @relation("RcaApprover", fields: [approvedById], references: [id])

  actions  RcaAction[]
  evidence File[]

  @@index([organizationId, status])
  @@map("rca_reports")
}

/// A corrective or preventive action, pointed at a real task rather than a second to-do system.
///
/// The action row carries the promise — what, who, by when, verified by whom — and `taskId` carries
/// the work. Tracking the work here as well would give the organization two task lists that
/// disagree, which is exactly what a CAPA register usually becomes.
model RcaAction {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  rcaReportId    String        @map("rca_report_id") @db.Uuid
  kind           RcaActionKind
  description    String
  ownerId        String?       @map("owner_id") @db.Uuid
  dueDate        DateTime?     @map("due_date") @db.Date
  taskId         String?       @map("task_id") @db.Uuid
  completedAt    DateTime?     @map("completed_at")
  /// Somebody checked that the action actually worked. Separate from completion on purpose.
  verifiedAt     DateTime?     @map("verified_at")
  verifiedById   String?       @map("verified_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  rcaReport    RcaReport    @relation(fields: [rcaReportId], references: [id], onDelete: Cascade)
  owner        User?        @relation("RcaActionOwner", fields: [ownerId], references: [id])
  verifiedBy   User?        @relation("RcaActionVerifier", fields: [verifiedById], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  @@index([rcaReportId, kind])
  @@index([organizationId, dueDate])
  @@map("rca_actions")
}

/// Something is broken right now.
model Incident {
  id                        String             @id @default(uuid(7)) @db.Uuid
  organizationId            String             @map("organization_id") @db.Uuid
  /// Sequential per organization; displayed as "INC-<number>".
  number                    Int
  title                     String
  description               String
  status                    IncidentStatus     @default(OPEN)
  severity                  Priority           @default(HIGH)
  /// Who is affected and how, in words.
  impact                    String?
  projectId                 String?            @map("project_id") @db.Uuid
  productId                 String?            @map("product_id") @db.Uuid
  problemId                 String?            @map("problem_id") @db.Uuid
  ownerId                   String?            @map("owner_id") @db.Uuid
  /// When the impact began. Often earlier than when anybody noticed.
  startedAt                 DateTime           @map("started_at")
  /// When somebody noticed. Kept apart from `startedAt` because the gap between them is the
  /// number worth improving.
  detectedAt                DateTime           @map("detected_at")
  resolvedAt                DateTime?          @map("resolved_at")
  resolvedById              String?            @map("resolved_by_id") @db.Uuid
  resolution                String?
  closedAt                  DateTime?          @map("closed_at")
  /// Internal only. There is no client shape anywhere that carries this field.
  internalNotes             String?            @map("internal_notes")
  /// What a client may be told — written by a person, published by a person, never generated.
  clientSummary             String?            @map("client_summary")
  clientSummaryPublishedAt  DateTime?          @map("client_summary_published_at")
  emergencyFixStatus        EmergencyFixStatus @default(NONE) @map("emergency_fix_status")
  emergencyFixReason        String?            @map("emergency_fix_reason")
  emergencyFixRequestedById String?            @map("emergency_fix_requested_by_id") @db.Uuid
  emergencyFixDecidedById   String?            @map("emergency_fix_decided_by_id") @db.Uuid
  emergencyFixDecidedAt     DateTime?          @map("emergency_fix_decided_at")
  createdById               String             @map("created_by_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  organization            Organization @relation(fields: [organizationId], references: [id])
  project                 Project?     @relation(fields: [projectId], references: [id])
  product                 Product?     @relation(fields: [productId], references: [id])
  problem                 Problem?     @relation(fields: [problemId], references: [id])
  owner                   User?        @relation("IncidentOwner", fields: [ownerId], references: [id])
  createdBy               User         @relation("IncidentCreator", fields: [createdById], references: [id])
  resolvedBy              User?        @relation("IncidentResolver", fields: [resolvedById], references: [id])
  emergencyFixRequestedBy User?        @relation("EmergencyFixRequester", fields: [emergencyFixRequestedById], references: [id])
  emergencyFixDecidedBy   User?        @relation("EmergencyFixDecider", fields: [emergencyFixDecidedById], references: [id])

  timeline IncidentTimelineEntry[]
  links    IncidentLink[]
  evidence File[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([problemId])
  /// The incident list's ordering.
  @@index([organizationId, severity(sort: Desc), startedAt(sort: Desc), id(sort: Desc)], map: "incidents_org_severity_started_idx")
  @@map("incidents")
}

/// The incident's own account of itself. Append-only: nothing here is ever edited or removed.
///
/// A table rather than the `timeline jsonb` the plan sketched, because every entry names an actor
/// and a moment, and a blob cannot be indexed by either — nor can a foreign key stop it naming
/// somebody who does not exist.
model IncidentTimelineEntry {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  incidentId     String               @map("incident_id") @db.Uuid
  kind           IncidentTimelineKind
  body           String
  actorId        String?              @map("actor_id") @db.Uuid
  occurredAt     DateTime             @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor        User?        @relation("IncidentTimelineActor", fields: [actorId], references: [id])

  @@index([incidentId, occurredAt])
  @@map("incident_timeline_entries")
}

/// What an incident touches: the tickets it explains, the tasks fixing it, the release that
/// caused it or carried the fix.
///
/// Three nullable foreign keys and a `kind`, rather than one polymorphic id, so the database still
/// refuses a link to a row that does not exist.
model IncidentLink {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  incidentId     String           @map("incident_id") @db.Uuid
  kind           IncidentLinkKind
  ticketId       String?          @map("ticket_id") @db.Uuid
  taskId         String?          @map("task_id") @db.Uuid
  releaseId      String?          @map("release_id") @db.Uuid
  addedById      String?          @map("added_by_id") @db.Uuid
  addedAt        DateTime         @default(now()) @map("added_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  release      Release?     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("IncidentLinkAuthor", fields: [addedById], references: [id])

  @@index([incidentId, kind])
  @@index([ticketId])
  @@map("incident_links")
}

// ---------------------------------------------------------------------------------------------
// Duplicate and related work items
// ---------------------------------------------------------------------------------------------

/// How two work items of the same kind are related.
///
/// DUPLICATE_OF is directed — the source is the copy, the target is the one being kept — because
/// the direction is the whole content of the statement. RELATED_TO is symmetric and is stored with
/// the two ids in ascending order, so that linking B to A when A is already linked to B collides
/// with the unique index instead of making a second row that says the same thing.
enum WorkRelationType {
  DUPLICATE_OF
  RELATED_TO
}

/// A typed link between two tickets.
///
/// Deliberately a *pointer*, never a merge. Marking one ticket a duplicate of another writes this
/// row and (optionally) closes the duplicate with a note; it moves no reply, no attachment, no SLA
/// record and no audit entry between the two rows. Both tickets keep their own history, and their
/// own clients keep their own thread — which is the only shape that works when two different
/// clients report the same fault.
///
/// This is not the problem model in `problems`: a Problem is a third record several clients'
/// tickets are grouped under so a fault can be owned, analysed and closed, and it is internal-only.
/// A relation is the desk's own smaller statement — "this one is the same as that one" — and it
/// works for two tickets from one client, which a problem does not.
model TicketRelation {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  type            WorkRelationType
  /// For a duplicate, the copy.
  sourceTicketId  String           @map("source_ticket_id") @db.Uuid
  /// For a duplicate, the ticket being kept.
  targetTicketId  String           @map("target_ticket_id") @db.Uuid
  /// Why, in the linker's words. Internal: it is never projected into a client response.
  note            String?
  /// Whether creating this link also closed the duplicate, so the unlink audit can say so.
  closedDuplicate Boolean          @default(false) @map("closed_duplicate")
  linkedById      String?          @map("linked_by_id") @db.Uuid
  linkedAt        DateTime         @default(now()) @map("linked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sourceTicket Ticket       @relation("TicketRelationSource", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket Ticket       @relation("TicketRelationTarget", fields: [targetTicketId], references: [id], onDelete: Cascade)
  linkedBy     User?        @relation("TicketRelationAuthor", fields: [linkedById], references: [id])

  /// One row per ordered pair. Combined with the ascending-id storage of RELATED_TO and the
  /// service's check of the reverse pair, this is what stops one pair carrying two links.
  @@unique([sourceTicketId, targetTicketId])
  @@index([targetTicketId])
  @@index([organizationId, type])
  @@map("ticket_relations")
}

/// The same link between two tasks. Same shape, same rules, same code path — see
/// `modules/relations`.
model TaskRelation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  type           WorkRelationType
  sourceTaskId   String           @map("source_task_id") @db.Uuid
  targetTaskId   String           @map("target_task_id") @db.Uuid
  note           String?
  linkedById     String?          @map("linked_by_id") @db.Uuid
  linkedAt       DateTime         @default(now()) @map("linked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  sourceTask   Task         @relation("TaskRelationSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask   Task         @relation("TaskRelationTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)
  linkedBy     User?        @relation("TaskRelationAuthor", fields: [linkedById], references: [id])

  @@unique([sourceTaskId, targetTaskId])
  @@index([targetTaskId])
  @@index([organizationId, type])
  @@map("task_relations")
}
