// Ashniva Desk — Prisma schema (Phase 0 foundation + Phase 1 MVP tables).
//
// The complete planned schema is documented in docs/database-plan.md. Each later phase adds its
// own models and migrations. Conventions:
//   - IDs are UUID v7 (time-ordered).
//   - Tenant-scoped tables carry organizationId; soft-deletable tables carry deletedAt.
//   - Enum values are UPPER_SNAKE_CASE and mirror packages/types.
//   - Table and column names use snake_case in PostgreSQL via @@map / @map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Organizations (tenants)
// ---------------------------------------------------------------------------------------------

enum OrganizationType {
  OWN_GROUP
  CORPORATE_CUSTOMER
  CONTRACT_CLIENT
  AMC_CLIENT
}

model Organization {
