// ---------------------------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------------------------

model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  description    String?
  leadUserId     String?   @map("lead_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  lead         User?        @relation("TeamLead", fields: [leadUserId], references: [id])
  members      TeamMember[]
  projects     Project[]
  tickets      Ticket[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------------------------

/// organizationId is the service-provider organization that runs the project (tenant scope for
/// internal users). clientOrganizationId is the company the work is done for; client-portal
/// queries are scoped by it and NULL means an internal project that no client can see.
model Project {
  id                   String        @id @default(uuid(7)) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  clientOrganizationId String?       @map("client_organization_id") @db.Uuid
  /// Short code used as the prefix of task numbers shown in the UI, e.g. "ACM".
  code                 String
  name                 String
  description          String?
  type                 ProjectType
  status               ProjectStatus @default(ACTIVE)
  managerUserId        String?       @map("manager_user_id") @db.Uuid
  leadUserId           String?       @map("lead_user_id") @db.Uuid
  teamId               String?       @map("team_id") @db.Uuid
  startDate            DateTime?     @map("start_date") @db.Date
  targetDate           DateTime?     @map("target_date") @db.Date
  requiresClientUat    Boolean       @default(false) @map("requires_client_uat")
  createdById          String        @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  organization       Organization      @relation("ProjectOwner", fields: [organizationId], references: [id])
  clientOrganization Organization?     @relation("ProjectClient", fields: [clientOrganizationId], references: [id])
  manager            User?             @relation("ProjectManager", fields: [managerUserId], references: [id])
  lead               User?             @relation("ProjectLead", fields: [leadUserId], references: [id])
  createdBy          User              @relation("ProjectCreator", fields: [createdById], references: [id])
  team               Team?             @relation(fields: [teamId], references: [id])
  members            ProjectMember[]
  tasks              Task[]
  tickets            Ticket[]
  clientUpdates      ClientUpdate[]
  files              File[]
  contracts          Contract[]
  milestones         Milestone[]
  slaPolicies        SlaPolicy[]
  changeRequests     ChangeRequest[]
  approvals          ApprovalRequest[]
  repositoryLinks    RepositoryLink[]
  releaseNotes       ReleaseNote[]
  invoices           Invoice[]

  aiSummaries AiSummary[]

  testingAssignments TestingAssignment[]
  testAccounts       TestAccount[]
  releases           Release[]
  releasePolicy      ProjectReleasePolicy?

  testEnvironments TestEnvironment[]

  onCallSchedules  OnCallSchedule[]
  supportOwnership SupportOwnership?
  products         Product[]
  calls            CallLog[]
  conversations    Conversation[]
  messages         Message[]
  problems         Problem[]
  incidents        Incident[]
  workPlan         ProjectWorkPlan?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([clientOrganizationId])
  /// "The projects I manage / lead" is how the operational dashboard scopes a manager, and
  /// without these it is a sequential scan of every project in the installation.
  @@index([organizationId, managerUserId])
  @@index([organizationId, leadUserId])
  @@map("projects")
}

model ProjectMember {
  projectId        String            @map("project_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  role             ProjectMemberRole @default(DEVELOPER)
  /// What this person is responsible for here — Frontend, API, DevOps. Free-form rather than an
  /// enum: every team names these differently, and a closed list would mean a migration each time
  /// one of them wanted another. One person may hold several.
  responsibilities String[]          @map("responsibilities")
  createdAt        DateTime          @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// One phase plan per project: headings, titles and timed points from a PDF or entered by hand.
model ProjectWorkPlan {
  id             String               @id @default(uuid(7)) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  projectId      String               @unique @map("project_id") @db.Uuid
  sourceFileId   String?              @map("source_file_id") @db.Uuid
  source         ProjectWorkPlanSource
  createdById    String               @map("created_by_id") @db.Uuid
  assignedToId   String?              @map("assigned_to_id") @db.Uuid
  priority       Priority             @default(MEDIUM)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id])
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFile   File?                 @relation(fields: [sourceFileId], references: [id])
  createdBy    User                  @relation("WorkPlanCreator", fields: [createdById], references: [id])
  assignedTo   User?                 @relation("WorkPlanAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  phases       ProjectWorkPlanPhase[]
  scores       ProjectWorkPlanScore[]

  @@index([organizationId])
  @@index([assignedToId])
  @@map("project_work_plans")
}

model ProjectWorkPlanPhase {
  id           String   @id @default(uuid(7)) @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  heading      String
  sortOrder    Int      @map("sort_order")
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  priority     Priority?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan       ProjectWorkPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("WorkPlanPhaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  titles     ProjectWorkPlanTitle[]

  @@index([planId, sortOrder])
  @@index([assignedToId])
  @@map("project_work_plan_phases")
}

model ProjectWorkPlanTitle {
  id           String @id @default(uuid(7)) @db.Uuid
  phaseId      String @map("phase_id") @db.Uuid
  title        String
  sortOrder    Int    @map("sort_order")
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  priority     Priority?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  phase      ProjectWorkPlanPhase   @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignedTo User?                  @relation("WorkPlanTitleAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  points     ProjectWorkPlanPoint[]
  tasks      Task[]

  @@index([phaseId, sortOrder])
  @@index([assignedToId])
  @@map("project_work_plan_titles")
}

model ProjectWorkPlanPoint {
  id              String              @id @default(uuid(7)) @db.Uuid
  titleId         String              @map("title_id") @db.Uuid
  body            String
  estimateMinutes Int                 @map("estimate_minutes")
  sortOrder       Int                 @map("sort_order")
  status          WorkPlanPointStatus @default(PENDING)
  startedAt       DateTime?           @map("started_at")
  dueAt           DateTime?           @map("due_at")
  completedAt     DateTime?           @map("completed_at")
  startedById     String?             @map("started_by_id") @db.Uuid
  completedById   String?             @map("completed_by_id") @db.Uuid
  submittedAt     DateTime?           @map("submitted_at")
  penaltyApplied  Boolean             @default(false) @map("penalty_applied")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  title       ProjectWorkPlanTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)
  startedBy   User?                @relation("WorkPlanPointStarter", fields: [startedById], references: [id])
  completedBy User?                @relation("WorkPlanPointCompleter", fields: [completedById], references: [id])
  notes       ProjectWorkPlanNote[]

  @@index([titleId, sortOrder])
  @@index([startedById])
  @@index([status])
  @@map("project_work_plan_points")
}

model ProjectWorkPlanNote {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  pointId        String           @map("point_id") @db.Uuid
  parentId       String?          @map("parent_id") @db.Uuid
  authorId       String           @map("author_id") @db.Uuid
  kind           WorkPlanNoteKind
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")

  point   ProjectWorkPlanPoint  @relation(fields: [pointId], references: [id], onDelete: Cascade)
  parent  ProjectWorkPlanNote?  @relation("WorkPlanNoteThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies ProjectWorkPlanNote[] @relation("WorkPlanNoteThread")
  author  User                  @relation("WorkPlanNoteAuthor", fields: [authorId], references: [id])

  @@index([pointId, createdAt])
  @@index([parentId])
  @@index([organizationId])
  @@map("project_work_plan_notes")
}

model ProjectWorkPlanScore {
  planId  String @map("plan_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  percent Int    @default(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  plan ProjectWorkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planId, userId])
  @@map("project_work_plan_scores")
}

// ---------------------------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------------------------

model TaskCategory {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  kind           TaskCategoryKind
  sortOrder      Int              @default(0) @map("sort_order")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]

  @@unique([organizationId, name])
  @@map("task_categories")
}

/// Per-organization sequences for human-readable task and ticket numbers. Incremented inside
/// the same transaction that inserts the row, so numbers never repeat or skip on conflict.
/// Per-organization sequence numbers (task, ticket, contract, change request, problem, incident).
/// Deliberately exempt from row-level security: every row belongs to the service provider, and a
/// client raising work from the portal bumps the provider's counter while the connection carries
/// the client's tenant — an `organization_id = app_tenant_id()` policy would refuse it. See
/// `migrations/20260929090000_roles_row_level_security` and `test/row-level-security.e2e-spec.ts`.
model OrganizationCounter {
  organizationId String      @map("organization_id") @db.Uuid
  kind           CounterKind
  value          Int         @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, kind])
  @@map("organization_counters")
}

model Task {
  id                 String     @id @default(uuid(7)) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  projectId          String     @map("project_id") @db.Uuid
  /// Sequential per organization; displayed as "<project code>-<number>".
  number             Int
  title              String
  description        String?
  status             TaskStatus @default(ASSIGNED)
  priority           Priority   @default(MEDIUM)
  categoryId         String?    @map("category_id") @db.Uuid
  module             String?
  assignedToId       String?    @map("assigned_to_id") @db.Uuid
  createdById        String     @map("created_by_id") @db.Uuid
  reviewerId         String?    @map("reviewer_id") @db.Uuid
  testerId           String?    @map("tester_id") @db.Uuid
  /// Ticket this task was converted from (one ticket can produce several tasks).
  ticketId           String?    @map("ticket_id") @db.Uuid
  /// Milestone the work counts towards (drives automatic milestone progress).
  milestoneId        String?    @map("milestone_id") @db.Uuid
  /// Change request the task was generated from (traceability).
  changeRequestId    String?    @map("change_request_id") @db.Uuid
  /// Work-plan topic this task was created from. One live task per title.
  workPlanTitleId    String?    @unique @map("work_plan_title_id") @db.Uuid
  dueDate            DateTime?  @map("due_date") @db.Date
  /// When the work is meant to begin. A task whose start is still ahead sits in the assignee's
  /// "upcoming" view and cannot be started; it needs no job to activate it, because the queue is
  /// filtered on this column at read time rather than a status being flipped on a timer.
  scheduledStartAt   DateTime?  @map("scheduled_start_at")
  /// Expected completion as an instant. `dueDate` is a calendar date and stays the reporting
  /// grain; this is what the on-time/delayed indicator compares against, because "late" is a
  /// question about a moment and a date cannot answer it.
  dueAt              DateTime?  @map("due_at")
  /// What the work is: Frontend, API, Database… Free-form tags, matched by the support router
  /// against what people are responsible for on the project.
  workAreas          String[]   @map("work_areas")
  estimateMinutes    Int?       @map("estimate_minutes")
  acceptanceCriteria String?    @map("acceptance_criteria")
  /// When true, completion creates a client update that waits for publishing.
  clientVisible      Boolean    @default(false) @map("client_visible")
  blockedReason      String?    @map("blocked_reason")
  startedAt          DateTime?  @map("started_at")
  submittedAt        DateTime?  @map("submitted_at")
  completedAt        DateTime?  @map("completed_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  organization   Organization        @relation(fields: [organizationId], references: [id])
  project        Project             @relation(fields: [projectId], references: [id])
  category       TaskCategory?       @relation(fields: [categoryId], references: [id])
  assignedTo     User?               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy      User                @relation("TaskCreator", fields: [createdById], references: [id])
  reviewer       User?               @relation("TaskReviewer", fields: [reviewerId], references: [id])
  tester         User?               @relation("TaskTester", fields: [testerId], references: [id])
  ticket         Ticket?             @relation(fields: [ticketId], references: [id])
  milestone      Milestone?          @relation(fields: [milestoneId], references: [id])
  changeRequest  ChangeRequest?      @relation(fields: [changeRequestId], references: [id])
  workPlanTitle  ProjectWorkPlanTitle? @relation(fields: [workPlanTitleId], references: [id], onDelete: SetNull)
  statusHistory  TaskStatusHistory[]
  comments       Comment[]
  workLogs       WorkLog[]
  clientUpdates  ClientUpdate[]
  files          File[]
  codeActivities CodeActivity[]

  testingAssignments TestingAssignment[]
  releaseItems       ReleaseItem[]

  uatRequests UatRequest[]

  conversations Conversation[]
  calls         CallLog[]

  problemFixes           Problem[]      @relation("ProblemFixTask")
  problemPreventiveTests Problem[]      @relation("ProblemPreventiveTestTask")
  rcaActions             RcaAction[]
  incidentLinks          IncidentLink[]

  relationsAsSource TaskRelation[] @relation("TaskRelationSource")
  relationsAsTarget TaskRelation[] @relation("TaskRelationTarget")

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([projectId, status])
  @@index([scheduledStartAt])
  @@index([dueAt])
  @@index([assignedToId, dueDate])
  @@index([reviewerId])
  @@index([testerId])
  @@index([ticketId])
  @@index([milestoneId])
  @@index([changeRequestId])
  /// "Started today" and "completed today" are asked on every dashboard load, of the whole
  /// organization at once; neither column was indexed and both were full scans of `tasks`.
  @@index([organizationId, startedAt])
  @@index([organizationId, completedAt])
  @@map("tasks")
}

/// Append-only history of every status change (the "History" tab on the task screen).
model TaskStatusHistory {
  id          String      @id @default(uuid(7)) @db.Uuid
  taskId      String      @map("task_id") @db.Uuid
  fromStatus  TaskStatus? @map("from_status")
  toStatus    TaskStatus  @map("to_status")
  changedById String      @map("changed_by_id") @db.Uuid
  /// Review outcome, block reason, reopen reason, …
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([taskId, createdAt])
  @@map("task_status_history")
}

/// Time and completion evidence recorded by the person doing the work. Also written when a task
/// is submitted for review ("what was completed, time spent, proof").
model WorkLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  workDate       DateTime @map("work_date") @db.Date
  minutes        Int
  summary        String
  /// Optional evidence: a link (URL) or a git reference such as a branch, commit or PR.
  proofUrl       String?  @map("proof_url")
  gitRef         String?  @map("git_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization         @relation(fields: [organizationId], references: [id])
  task          Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id])
  files         File[]
  ledgerEntries ContractHourLedger[]

  @@index([organizationId, workDate])
  @@index([userId, workDate])
  @@index([taskId])
  @@map("work_logs")
}

// ---------------------------------------------------------------------------------------------
// Comments (tasks and tickets)
// ---------------------------------------------------------------------------------------------

/// Exactly one of taskId / ticketId / changeRequestId is set (CHECK constraint in the
/// migration). INTERNAL comments are never serialized into client-portal responses.
model Comment {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  taskId          String?    @map("task_id") @db.Uuid
  ticketId        String?    @map("ticket_id") @db.Uuid
  changeRequestId String?    @map("change_request_id") @db.Uuid
  authorId        String     @map("author_id") @db.Uuid
  visibility      Visibility @default(INTERNAL)
  body            String
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ticket        Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id])
  files         File[]

  @@index([taskId, createdAt])
  @@index([ticketId, createdAt])
  @@index([changeRequestId, createdAt])
  @@map("comments")
}

// ---------------------------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------------------------

/// organizationId is the service-provider organization that handles the ticket.
/// clientOrganizationId is the requester's company (a client, a group company, or the provider
/// itself for internal tickets) and scopes what the client portal can see.
model Ticket {
  id                   String       @id @default(uuid(7)) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  clientOrganizationId String       @map("client_organization_id") @db.Uuid
  /// Sequential per organization; displayed as "T-<number>".
  number               Int
  title                String
  description          String
  type                 TicketType   @default(SUPPORT)
  priority             Priority     @default(MEDIUM)
  status               TicketStatus @default(NEW)
  source               TicketSource @default(PORTAL)
  projectId            String?      @map("project_id") @db.Uuid
  module               String?
  /// Free text captured on the raise form: what the client cannot do because of this.
  impact               String?
  requesterId          String       @map("requester_id") @db.Uuid
  assignedToId         String?      @map("assigned_to_id") @db.Uuid
  teamId               String?      @map("team_id") @db.Uuid
  resolution           String?
  resolvedAt           DateTime?    @map("resolved_at")
  closedAt             DateTime?    @map("closed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  organization       Organization          @relation("TicketOwner", fields: [organizationId], references: [id])
  clientOrganization Organization          @relation("TicketClient", fields: [clientOrganizationId], references: [id])
  project            Project?              @relation(fields: [projectId], references: [id])
  requester          User                  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignedTo         User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id])
  team               Team?                 @relation(fields: [teamId], references: [id])
  statusHistory      TicketStatusHistory[]
  comments           Comment[]
  linkedTasks        Task[]
  clientUpdates      ClientUpdate[]
  files              File[]
  sla                TicketSla?
  slaEvents          SlaEvent[]
  ledgerEntries      ContractHourLedger[]

  aiSummaries AiSummary[]

  testingAssignments TestingAssignment[]
  releaseItems       ReleaseItem[]

  /// Set when the ticket arrived through the support ingress of a registered product.
  productId           String? @map("product_id") @db.Uuid
  /// Who actually reported it, when that person has no Desk account.
  externalRequesterId String? @map("external_requester_id") @db.Uuid
  /// The calling system's own case number, so both sides can reconcile.
  externalReference   String? @map("external_reference")

  product            Product?                  @relation(fields: [productId], references: [id])
  externalRequester  ExternalRequester?        @relation(fields: [externalRequesterId], references: [id])
  routingState       TicketRoutingState?
  routingTrail       TicketRoutingTrail[]
  ingressRequests    SupportIngressRequest[]
  calls              CallLog[]
  conversations      Conversation[]
  callbackDeliveries SupportCallbackDelivery[]

  /// The version the reporter was on, as they reported it. Free text: a client names their build,
  /// and forcing it into a release id would lose the reports that matter most — the ones from
  /// somebody running something we did not expect.
  productVersion String?  @map("product_version")
  /// Words worth matching on, extracted once when the ticket is raised or edited.
  keywords       String[]
  /// The coarse bucket for duplicate detection: product, module, version and error code, joined.
  /// Readable on purpose — somebody looking at the row can see why two tickets were compared.
  fingerprint    String?
  /// The problem this ticket was linked to, if it was. The link row carries the relation.
  problemId      String?  @map("problem_id") @db.Uuid

  problem              Problem?          @relation("ProblemPrimaryTickets", fields: [problemId], references: [id])
  problemLinks         ProblemTicket[]
  similarityMatches    SimilarityMatch[] @relation("SimilaritySubject")
  similarityCandidates SimilarityMatch[] @relation("SimilarityCandidate")
  incidentLinks        IncidentLink[]

  relationsAsSource TicketRelation[] @relation("TicketRelationSource")
  relationsAsTarget TicketRelation[] @relation("TicketRelationTarget")

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientOrganizationId, status])
  @@index([assignedToId])
  @@index([projectId])
  @@index([problemId])
  @@index([organizationId, fingerprint])
  /// Array overlap: "which other tickets share any of these words". A btree cannot answer that.
  @@index([keywords], type: Gin)
  @@map("tickets")
}

/// Append-only activity: status changes, assignments and conversions.
model TicketStatusHistory {
  id          String        @id @default(uuid(7)) @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  fromStatus  TicketStatus? @map("from_status")
  toStatus    TicketStatus  @map("to_status")
  changedById String        @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_status_history")
}

// ---------------------------------------------------------------------------------------------
// Client updates (what the client reads)
// ---------------------------------------------------------------------------------------------

model ClientUpdate {
  id                   String             @id @default(uuid(7)) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  clientOrganizationId String             @map("client_organization_id") @db.Uuid
  projectId            String             @map("project_id") @db.Uuid
  taskId               String?            @map("task_id") @db.Uuid
  ticketId             String?            @map("ticket_id") @db.Uuid
  workDate             DateTime           @map("work_date") @db.Date
  title                String
  body                 String
  status               ClientUpdateStatus @default(PENDING)
  authorId             String             @map("author_id") @db.Uuid
  publishedById        String?            @map("published_by_id") @db.Uuid
  publishedAt          DateTime?          @map("published_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization       Organization @relation("ClientUpdateOwner", fields: [organizationId], references: [id])
  clientOrganization Organization @relation("ClientUpdateClient", fields: [clientOrganizationId], references: [id])
  project            Project      @relation(fields: [projectId], references: [id])
  task               Task?        @relation(fields: [taskId], references: [id])
  ticket             Ticket?      @relation(fields: [ticketId], references: [id])
  author             User         @relation("ClientUpdateAuthor", fields: [authorId], references: [id])
  publishedBy        User?        @relation("ClientUpdatePublisher", fields: [publishedById], references: [id])

  @@index([organizationId, status, workDate])
  @@index([clientOrganizationId, status, workDate])
  @@index([projectId, workDate])
  @@map("client_updates")
}

// ---------------------------------------------------------------------------------------------
// Files (metadata; bytes live in S3-compatible storage)
// ---------------------------------------------------------------------------------------------

model File {
  id              String     @id @default(uuid(7)) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  projectId       String?    @map("project_id") @db.Uuid
  taskId          String?    @map("task_id") @db.Uuid
  ticketId        String?    @map("ticket_id") @db.Uuid
  commentId       String?    @map("comment_id") @db.Uuid
  workLogId       String?    @map("work_log_id") @db.Uuid
  contractId      String?    @map("contract_id") @db.Uuid
  milestoneId     String?    @map("milestone_id") @db.Uuid
  changeRequestId String?    @map("change_request_id") @db.Uuid
  approvalId      String?    @map("approval_id") @db.Uuid
  /// Attached to an internal conversation message. The same upload path, storage and tenancy as
  /// every other file — package 9b adds a parent, not a second file system.
  messageId       String?    @map("message_id") @db.Uuid
  name            String
  contentType     String     @map("content_type")
  sizeBytes       Int        @map("size_bytes")
  /// Object key in the bucket: <organizationId>/<uuid>/<sanitized name>. Never exposed to clients.
  storageKey      String     @unique @map("storage_key")
  visibility      Visibility @default(INTERNAL)
  uploadedById    String     @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  deletedAt       DateTime?  @map("deleted_at")

  organization             Organization     @relation(fields: [organizationId], references: [id])
  project                  Project?         @relation(fields: [projectId], references: [id])
  task                     Task?            @relation(fields: [taskId], references: [id])
  ticket                   Ticket?          @relation(fields: [ticketId], references: [id])
  comment                  Comment?         @relation(fields: [commentId], references: [id])
  workLog                  WorkLog?         @relation(fields: [workLogId], references: [id])
  contract                 Contract?        @relation(fields: [contractId], references: [id])
  milestone                Milestone?       @relation(fields: [milestoneId], references: [id])
  changeRequest            ChangeRequest?   @relation(fields: [changeRequestId], references: [id])
  approval                 ApprovalRequest? @relation(fields: [approvalId], references: [id])
  message                  Message?         @relation(fields: [messageId], references: [id])
  uploadedBy               User             @relation(fields: [uploadedById], references: [id])
  billingProfileLogos      BillingProfile[] @relation("BillingProfileLogo")
  billingProfileSignatures BillingProfile[] @relation("BillingProfileSignature")
  invoicePdfs              Invoice[]        @relation("InvoicePdf")
  invoiceHistoryPdfs       InvoiceHistory[] @relation("InvoiceHistoryPdf")

  testEvidence TestResult[] @relation("TestEvidence")

  /// Groups using this file as their picture.
  conversationImages Conversation[] @relation("ConversationImage")
  workPlans          ProjectWorkPlan[]

  /// Evidence attached to a root-cause analysis or an incident. Internal by construction: no
  /// client-facing parent, so the existing `files` policy admits no client to these rows.
  rcaReportId String? @map("rca_report_id") @db.Uuid
  incidentId  String? @map("incident_id") @db.Uuid

  rcaReport RcaReport? @relation(fields: [rcaReportId], references: [id])
  incident  Incident?  @relation(fields: [incidentId], references: [id])

  @@index([organizationId])
  @@index([taskId])
  @@index([ticketId])
  @@index([projectId])
  @@index([contractId])
  @@index([milestoneId])
  @@index([changeRequestId])
  @@index([approvalId])
  @@map("files")
}

// ---------------------------------------------------------------------------------------------
// Daily reports (one snapshot per person per day, refreshed by the reports service)
// ---------------------------------------------------------------------------------------------

model DailyReport {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  reportDate     DateTime @map("report_date") @db.Date
  /// Aggregates + task list: { minutesLogged, tasksCompleted, tasksInProgress, items: [...] }.
  /// Shape is DailyReportSnapshot in packages/types.
  snapshot       Json
  generatedAt    DateTime @default(now()) @map("generated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([userId, reportDate])
  @@index([organizationId, reportDate])
  @@map("daily_reports")
}

