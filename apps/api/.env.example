# Ashniva Desk API — local development settings.
# Copy to apps/api/.env. Every value here is for LOCAL DEVELOPMENT ONLY; production values come
# from the deployment platform's secret store (see docs/security-plan.md).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# How many reverse proxies sit in front of the API — a COUNT, or false when nothing does.
#
# Behind a load balancer this must be set. Two things depend on it: the rate limiter counts per
# client IP (with no trusted proxy every request carries the balancer's address, so the global
# limit throttles the whole deployment at once and the login limit stops telling people apart),
# and the refresh cookie's Secure flag follows the request's scheme, which is plain http on the
# hop from the balancer unless X-Forwarded-Proto is trusted.
#
# `true` is refused on purpose: it trusts the entire X-Forwarded-For chain, so a client can
# prepend addresses and choose its own rate-limit bucket. Count the proxies instead — 1 for a
# single load balancer, 2 for a CDN in front of one.
#
# With NODE_ENV=production this must be stated, and `false` counts as stating it. There is no
# default there: an unset value behind a load balancer costs the refresh cookie its `Secure`
# flag, silently, and that is not a thing to inherit from an example file.
TRUST_PROXY=false

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://ashniva:ashniva_dev_password@localhost:5432/ashniva_desk?schema=public

# Connection pool, per API instance. PostgreSQL sees DB_POOL_MAX × instances, which must stay
# under its max_connections with room left for migrations and psql.
#
# Every checkout costs one extra round trip: the pool stamps the request's tenant on the
# connection it hands out so row-level security applies (see TenantAwarePool). A pool too small
# for the traffic therefore pays that round trip more often as well as making callers queue —
# DB_POOL_ACQUIRE_TIMEOUT_MS is what turns that queue into an error instead of a hang.
# DB_STATEMENT_TIMEOUT_MS=0 disables the statement limit.
DB_POOL_MAX=11
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# Redis (BullMQ queues and the Socket.IO adapter that carries events between API instances)
REDIS_URL=redis://localhost:6379

# How long SIGTERM waits for queue workers to finish jobs they already started. Keep it shorter
# than the orchestrator's kill grace period, or the process dies mid-drain.
QUEUE_SHUTDOWN_GRACE_MS=15000

# S3-compatible storage (MinIO in docker-compose.yml)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ashniva-desk-dev
STORAGE_ACCESS_KEY=ashniva
STORAGE_SECRET_KEY=ashniva_dev_password
STORAGE_FORCE_PATH_STYLE=true
# Creates the bucket if it is missing. Convenient locally; refused in production, where it would
# turn a mistyped STORAGE_BUCKET into a new, empty, unbacked-up bucket instead of an error.
STORAGE_AUTO_CREATE_BUCKET=true

# JWT — generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# THESE TWO VALUES ARE IN THE REPOSITORY, so they are public. The API refuses to start in
# production with either of them, or with anything else that reads as a placeholder, or with the
# same secret used for both tokens. Length alone was never the check that mattered: both of these
# are comfortably over 32 characters.
#
# The check is these two strings by name plus a placeholder-marker heuristic, not proof that a
# secret is strong. The other non-production secrets published in this repository — the preview
# pair in docker-compose.yml and the CI pair in .github/workflows/ci.yml — are equally public and
# pass it. Generate your own; do not reuse anything that is in git.
JWT_ACCESS_SECRET=local-dev-access-secret-please-change-0123456789
JWT_REFRESH_SECRET=local-dev-refresh-secret-please-change-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Encrypts stored secrets at rest with AES-256-GCM: integration credentials (SMTP passwords,
# WhatsApp, AI and git tokens, the IVR credential and its webhook secret), test-account passwords
# and the support-callback signing secrets. Exactly 32 bytes, base64.
#
#   openssl rand -base64 32
#
# Optional here, so a developer can run the parts of the app that store nothing encrypted.
# REQUIRED with NODE_ENV=production: there is no default and no fallback, and the API refuses to
# start without it. A key that does not decode to exactly 32 bytes is refused everywhere.
#
# Keep it with the database backups and restore them together. Changing it does not re-encrypt
# what is already stored, and a database restored without its key cannot decrypt any of it —
# every integration has to be reconfigured by hand. See docs/backup-and-restore.md §1.
APP_ENCRYPTION_KEY=

# Comma-separated list of allowed browser origins. Required in production — the same list governs
# the websocket handshake, so leaving it empty there refuses the web app rather than allowing it.
CORS_ORIGINS=http://localhost:5173

# Whether /api/docs is served. Unset means "on outside production": the document is a complete map
# of every endpoint and every DTO shape, which is reconnaissance a production deployment has no
# reason to publish. Set it to true only if you deliberately want it on a production-mode box.
# API_DOCS_ENABLED=

# Shared secret a Prometheus scraper presents as `Authorization: Bearer <token>` at /metrics.
# Leave it unset (or empty, as here) and the endpoint answers 404: nobody configured a reader, so
# there is none. Set, it must be at least 16 characters or the API refuses to start.
# Generate one with: openssl rand -hex 32
METRICS_TOKEN=

# Lets `pnpm db:seed` plant demo users with NODE_ENV=production, for a disposable preview only.
# The demo users share one documented password; never set this on a real deployment.
ALLOW_DEMO_SEED=false

# Hosts an outbound integration may reach even though they sit on a private network.
#
# Every URL the API fetches on an operator's behalf — a self-hosted GitHub or GitLab, the AI
# endpoint, a test account's reset hook — is checked against the address it resolves to, and
# loopback, private, link-local and cloud-metadata addresses are refused. List a hostname here to
# exempt that one host, for a GitLab or a staging environment that genuinely lives inside your
# network. Leave it empty unless you have such a host: it is the only way in.
# Example: OUTBOUND_ALLOWED_HOSTS=gitlab.internal.example,staging.internal.example
OUTBOUND_ALLOWED_HOSTS=

# SMTP servers reachable inside your network, by hostname, comma-separated.
#
# The same check applies to the mail server each organization configures: it is resolved, every
# address it answers with is judged, and the connection is opened to the approved address with the
# hostname kept for the TLS certificate. An internal relay is a normal way to run mail, so list it
# here. This list is deliberately separate from OUTBOUND_ALLOWED_HOSTS: naming your relay should
# let Desk send mail through it, not let the git, AI and WhatsApp integrations call it over HTTP.
# Example: SMTP_ALLOWED_HOSTS=mail.internal.example
SMTP_ALLOWED_HOSTS=

# Rate limiting: RATE_LIMIT_MAX requests per client IP per RATE_LIMIT_TTL_SECONDS.
#
# The counter is held in memory, per API instance — there is no shared store — so a deployment of
# N instances behind a load balancer lets one client through roughly N × RATE_LIMIT_MAX. Size the
# limit for that, and remember that TRUST_PROXY is what decides whose IP is being counted.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# Business timezone used for daily reports and SLA business hours
APP_TIMEZONE=Asia/Kolkata

# Password given to every seeded demo user (development only). There is no default when
# NODE_ENV=production: seeding there must name its own password.
SEED_USER_PASSWORD=ChangeMe123!

# Public URL of the web app (used in invitation and password-reset links) and token lifetimes.
#
# With NODE_ENV=production this must be SET; it is not checked for being a localhost address, and
# a deliberate localhost value is accepted — the docker-compose preview runs production-mode and
# really does serve the web app there. What the check prevents is a real deployment inheriting a
# value nobody chose, which would point every invitation and password-reset link at the
# recipient's own machine, fail silently, and look like a mail problem for a week.
APP_WEB_URL=http://localhost:5173
INVITATION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=60
REAUTH_TTL_SECONDS=300

# Outbound email and WhatsApp providers.
#   live — real SMTP and the Meta WhatsApp Cloud API, configured per tenant in the app
#   mock — captured in memory, nothing leaves the deployment (tests and local preview)
# Per-tenant server addresses, usernames and tokens are configured in Settings, not here.
MESSAGING_PROVIDER=live

# Outbound support callbacks — Desk telling a registered product what happened to its tickets.
#   live — a real HTTPS POST, through the same address guard every other outbound call uses
#   mock — recorded in memory, nothing leaves the deployment (tests and local preview)
# The endpoint URL and its signing secret are configured per product in the app, not here.
SUPPORT_CALLBACK_TRANSPORT=live

# AI progress summaries.
#   http — the configurable HTTP adapter. The endpoint, model and credential are set per tenant
#          in Settings → Integrations → AI provider, never here. No vendor is named in the code.
#   mock — summaries built from the source records themselves; reaches nothing (tests, preview)
AI_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=3

# Optional. When set, Projects → Summary → Upload PDF sends the brief to Gemini and fills phases.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REQUEST_TIMEOUT_MS=60000

# IVR support calls. Desk decides who a call should reach; Ashniva IVR places it.
#   tata — the real adapter
#   mock — places no telephone call, records what would have been asked (tests, preview)
# The provider's credentials and webhook secret are per tenant, in Settings → Integrations → IVR,
# encrypted at rest. Nothing about a telephony account belongs in this file.
IVR_PROVIDER=tata
# How long a minted recording playback URL stays valid. Every issue of one is audited.
IVR_RECORDING_URL_TTL_SECONDS=300

# Where a tenant's design tokens come from.
#   local  — the organization's own stored branding, edited in Admin → Branding (the default)
#   remote — an Ashniva Theme Manager, through that tenant's Theme Manager integration connection
# The vendor half of that integration does not exist yet: see docs/theme-manager-integration.md
# for exactly what the Theme Manager team has to supply. Desk works without it either way — the
# resolution order is cached document, then stored branding, then the built-in default theme.
# Credentials and the base URL are per tenant, in the integration connection, never here.
THEME_PROVIDER=local
# How long a fetched theme document is served before a background refresh. Bounds staleness,
# not latency: no request ever waits on the Theme Manager.
THEME_CACHE_TTL_SECONDS=300
THEME_REQUEST_TIMEOUT_MS=5000
