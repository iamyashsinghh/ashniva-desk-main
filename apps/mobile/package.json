{
  "name": "@ashniva/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Ashniva Desk mobile app (React Native + Expo)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "rimraf node_modules dist .expo coverage"
  },
  "dependencies": {
    "@ashniva/types": "workspace:*",
    "@ashniva/ui": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.94.4",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@ashniva/config": "workspace:*",
    "@react-native/assets-registry": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
