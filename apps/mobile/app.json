{
  "expo": {
    "name": "Ashniva Desk",
    "slug": "ashniva-desk",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ashnivadesk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashniva.desk",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.ashniva.desk",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4f4f2"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ashniva Desk uses your photos so you can attach a screenshot to a task or a ticket."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.desk.ashniva.com/api/v1"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f4f2"
    }
  }
}
